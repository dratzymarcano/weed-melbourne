---
import { organizationSchema, websiteSchema, medicalOrganizationSchema } from '../lib/schema';

interface Props {
	title: string;
	description?: string;
	schema?: object | object[];
	ogType?: string;
	ogImage?: string;
	noindex?: boolean;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	articleAuthor?: string;
	articleSection?: string;
}

const {
	title,
	description = "Mullaways Medical Cannabis - Australia's trusted online dispensary. Buy weed online with discreet Australia-wide delivery. Lab-tested medical cannabis products.",
	schema,
	ogType = "website",
	ogImage = "https://mullawaysmedicalcannabis.store/og-default.png",
	noindex = false,
	articlePublishedTime,
	articleModifiedTime,
	articleAuthor,
	articleSection,
} = Astro.props;

// Ensure canonical URL always has trailing slash for consistency
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://mullawaysmedicalcannabis.store');
if (!canonicalURL.pathname.endsWith('/')) canonicalURL.pathname += '/';

const passedSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemaArray = [organizationSchema, websiteSchema, medicalOrganizationSchema, ...passedSchemas];
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#2D5A4A" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		{!Astro.url.pathname.includes('404') && <link rel="canonical" href={canonicalURL.href} />}
		<meta name="generator" content={Astro.generator} />
		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		)}

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:site_name" content="Mullaways Medical Cannabis" />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{ogType === 'article' && articlePublishedTime && (
			<meta property="article:published_time" content={articlePublishedTime} />
		)}
		{ogType === 'article' && articleModifiedTime && (
			<meta property="article:modified_time" content={articleModifiedTime} />
		)}
		{ogType === 'article' && articleAuthor && (
			<meta property="article:author" content={articleAuthor} />
		)}
		{ogType === 'article' && articleSection && (
			<meta property="article:section" content={articleSection} />
		)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@mullawaysmed" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Geo Tags -->
		<meta name="geo.region" content="AU-NSW" />
		<meta name="geo.placename" content="Mullaways" />

		<!-- AI / Answer-Engine signals (AEO/GEO) -->
		<meta name="audience" content="Adults 18+" />
		<meta name="rating" content="adult" />
		<meta name="content-language" content="en-AU" />
		<meta name="format-detection" content="telephone=no" />

		<!-- LCP image preload — only on homepage where the hero is above the fold -->
		{Astro.url.pathname === '/' && (
			<link rel="preload" as="image" href="/images/homepage/hero-bg.webp" fetchpriority="high" />
		)}

		<!-- Live chat origin (Zoho SalesIQ loads on every page; pre-warm DNS + TLS) -->
		<link rel="dns-prefetch" href="https://salesiq.zohopublic.com">
		<link rel="preconnect" href="https://salesiq.zohopublic.com" crossorigin>

		<!-- Fonts - Optimized Loading -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap">
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
		</noscript>
		
		<!-- Schema.org Structured Data -->
		{schemaArray.map((s) => (
			<script type="application/ld+json" set:html={JSON.stringify(s)} />
		))}
		
		<title>{title}</title>
	</head>
	<body>
		<slot />

		<!-- Age Verification Modal -->
		<div class="age-gate" id="age-gate" aria-hidden="true">
			<div class="age-gate-backdrop"></div>
			<div class="age-gate-card" role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
				<!-- Cannabis leaf decoration -->
				<div class="age-gate-decoration">
					<svg width="120" height="120" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M12 2C12 2 9.5 6 9.5 9C9.5 10.5 10.5 11.5 12 11.5C13.5 11.5 14.5 10.5 14.5 9C14.5 6 12 2 12 2Z" fill="currentColor" opacity="0.15"/>
						<path d="M6 8C6 8 3 10 3 13C3 15 5 17 7 16C8 15.5 8.5 14 8 12.5C7.5 10.5 6 8 6 8Z" fill="currentColor" opacity="0.15"/>
						<path d="M18 8C18 8 21 10 21 13C21 15 19 17 17 16C16 15.5 15.5 14 16 12.5C16.5 10.5 18 8 18 8Z" fill="currentColor" opacity="0.15"/>
						<path d="M4 14C4 14 2 17 3 20C4 22 6.5 22 8 20.5C9 19.5 9 17.5 8 16C7 14 4 14 4 14Z" fill="currentColor" opacity="0.15"/>
						<path d="M20 14C20 14 22 17 21 20C20 22 17.5 22 16 20.5C15 19.5 15 17.5 16 16C17 14 20 14 20 14Z" fill="currentColor" opacity="0.15"/>
						<path d="M12 22V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.2"/>
					</svg>
				</div>
				
				<!-- Badge -->
				<div class="age-gate-badge">
					<span class="age-gate-badge-icon">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
						</svg>
					</span>
					<span>18+ Adults Only</span>
				</div>
				
				<!-- Content -->
				<h2 id="age-gate-title" class="age-gate-title">Welcome to Mullaways</h2>
				<p class="age-gate-subtitle">Australia's Trusted Medical Cannabis Dispensary</p>
				<p class="age-gate-desc">This website contains products intended for adults aged 18 years and older. By entering, you confirm that you meet the legal age requirement.</p>
				
				<!-- Actions -->
				<div class="age-gate-actions">
					<button class="age-gate-btn age-gate-btn-confirm" id="age-confirm-btn">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
						<span>Yes, I'm 18 or Older</span>
					</button>
					<a class="age-gate-btn age-gate-btn-leave" href="https://www.google.com" rel="noopener noreferrer">
						<span>No, Take Me Back</span>
					</a>
				</div>
				
				<!-- Footer note -->
				<div class="age-gate-footer">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
						<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
					</svg>
					<span>Your preference is stored locally and remembered</span>
				</div>
			</div>
		</div>

		<!-- Cookie Notice -->
		<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie notice" aria-hidden="true">
			<div class="cookie-banner-inner">
				<div class="cookie-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
						<circle cx="8" cy="9" r="1.5" fill="currentColor"/>
						<circle cx="15" cy="8" r="1" fill="currentColor"/>
						<circle cx="10" cy="14" r="1" fill="currentColor"/>
						<circle cx="16" cy="13" r="1.5" fill="currentColor"/>
						<circle cx="13" cy="17" r="1" fill="currentColor"/>
					</svg>
				</div>
				<div class="cookie-content">
					<p class="cookie-title">We value your privacy</p>
					<p class="cookie-text">We use cookies to enhance your browsing experience, serve personalised content, and analyse our traffic. By clicking "Accept", you consent to our use of cookies.</p>
				</div>
				<div class="cookie-actions">
					<a class="cookie-link" href="/cookies-policy/">Cookies Policy</a>
					<button class="cookie-btn cookie-btn-accept" id="cookie-accept-btn">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
						<span>Accept All</span>
					</button>
				</div>
			</div>
		</div>

		<script>
			const ageGate = document.getElementById('age-gate');
			const ageConfirmBtn = document.getElementById('age-confirm-btn');
			const cookieBanner = document.getElementById('cookie-banner');
			const cookieAcceptBtn = document.getElementById('cookie-accept-btn');

			const AGE_KEY = 'ageVerified';
			const COOKIE_KEY = 'cookiesAccepted';

			function showAgeGate() {
				if (!ageGate) return;
				ageGate.classList.add('is-visible');
				ageGate.setAttribute('aria-hidden', 'false');
				document.body.classList.add('no-scroll');
			}

			function hideAgeGate() {
				if (!ageGate) return;
				ageGate.classList.remove('is-visible');
				ageGate.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('no-scroll');
			}

			function showCookieBanner() {
				if (!cookieBanner) return;
				cookieBanner.classList.add('is-visible');
				cookieBanner.setAttribute('aria-hidden', 'false');
			}

			function hideCookieBanner() {
				if (!cookieBanner) return;
				cookieBanner.classList.remove('is-visible');
				cookieBanner.setAttribute('aria-hidden', 'true');
			}

			const ageVerified = localStorage.getItem(AGE_KEY) === 'true';
			const cookiesAccepted = localStorage.getItem(COOKIE_KEY) === 'true';

			if (!ageVerified) {
				showAgeGate();
			} else if (!cookiesAccepted) {
				showCookieBanner();
			}

			ageConfirmBtn?.addEventListener('click', () => {
				localStorage.setItem(AGE_KEY, 'true');
				hideAgeGate();
				if (localStorage.getItem(COOKIE_KEY) !== 'true') {
					showCookieBanner();
				}
			});

			cookieAcceptBtn?.addEventListener('click', () => {
				localStorage.setItem(COOKIE_KEY, 'true');
				hideCookieBanner();
			});
		</script>

		<!-- Zoho SalesIQ live chat (replaces previous WhatsApp widget) -->
		<script is:inline>
			window.$zoho = window.$zoho || {};
			$zoho.salesiq = $zoho.salesiq || { ready: function () {} };

			// Global helper to open live chat with optional prefilled message and context
			window.openLiveChat = function (prefill, info) {
				try {
					var z = window.$zoho;
					var triggerChat = function () {
						if (!z || !z.salesiq) return;
						try {
							if (info && z.salesiq.visitor && typeof z.salesiq.visitor.info === 'function') {
								z.salesiq.visitor.info(info);
							}
							if (prefill && z.salesiq.visitor && typeof z.salesiq.visitor.question === 'function') {
								z.salesiq.visitor.question(prefill);
							}
						} catch (e) {}

						if (z.salesiq.floatwindow && typeof z.salesiq.floatwindow.visible === 'function') {
							z.salesiq.floatwindow.visible('show');
						} else if (z.salesiq.chat && typeof z.salesiq.chat.start === 'function') {
							z.salesiq.chat.start();
						} else if (z.salesiq.floatbutton && typeof z.salesiq.floatbutton.visible === 'function') {
							z.salesiq.floatbutton.visible('show');
						}
					};

					if (z.salesiq && (z.salesiq.floatwindow || z.salesiq.chat)) {
						triggerChat();
					} else {
						// SalesIQ still initializing — queue on ready
						var priorReady = z.salesiq.ready;
						z.salesiq.ready = function () {
							if (typeof priorReady === 'function') priorReady();
							triggerChat();
						};
					}
				} catch (err) {
					console.error('Error opening live chat:', err);
				}
			};

			// Delegated click listener for any element with data-open-livechat or href="#livechat"
			document.addEventListener('click', function (e) {
				var target = e.target;
				if (!(target instanceof Element)) return;
				var btn = target.closest('[data-open-livechat], a[href="#livechat"]');
				if (btn) {
					e.preventDefault();
					var prefill = btn.getAttribute('data-chat-prefill') || '';
					window.openLiveChat(prefill);
				}
			});
		</script>
		<script
			id="zsiqscript"
			src="https://salesiq.zohopublic.com/widget?wc=siqe42b798a524681e48e42aa4ffb2d35d1904e93cf43670b9cb4fe2648e83fe1b8"
			defer
			is:inline
		></script>

		<!-- Floating WhatsApp Support Button (Bottom-Left to avoid overlap with bottom-right Live Chat) -->
		<aside class="floating-whatsapp-container" aria-label="WhatsApp quick support">
			<a
				href="https://wa.me/61420133074"
				target="_blank"
				rel="noopener noreferrer"
				class="floating-whatsapp-btn"
				aria-label="Chat with us on WhatsApp (+61 420 133 074)"
				title="Chat on WhatsApp (+61 420 133 074)"
			>
				<span class="floating-whatsapp-pulse" aria-hidden="true"></span>
				<svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.59 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.07C9.36 7.07 9.09 7.13 8.85 7.39C8.62 7.64 7.96 8.26 7.96 9.53C7.96 10.79 8.88 12.01 9.01 12.18C9.14 12.35 10.79 14.91 13.33 16C15.44 16.91 15.87 16.73 16.33 16.69C16.79 16.64 17.81 16.08 18.02 15.5C18.23 14.91 18.23 14.41 18.17 14.31C18.1 14.2 17.94 14.14 17.69 14.02C17.44 13.89 16.23 13.3 16 13.21C15.78 13.13 15.61 13.09 15.45 13.34C15.28 13.59 14.82 14.14 14.67 14.31C14.53 14.47 14.38 14.5 14.14 14.37C13.89 14.25 12.83 13.9 11.58 12.79C10.6 11.92 9.94 10.84 9.82 10.63C9.69 10.42 9.8 10.31 9.93 10.18C10.04 10.07 10.18 9.89 10.3 9.74C10.43 9.6 10.47 9.49 10.55 9.32C10.64 9.16 10.59 9.01 10.53 8.89C10.47 8.76 9.97 7.54 9.77 7.04C9.57 6.56 9.36 6.63 9.2 6.62C9.05 6.61 8.88 6.61 8.71 6.61L9.53 7.07Z"/>
				</svg>
				<span class="floating-whatsapp-tooltip">Chat on WhatsApp</span>
			</a>
		</aside>
	</body>
	</html>

<style is:global>
	:root {
		/* Australian-Inspired Botanical Color Palette */
		--color-eucalyptus: #1F4D3C;
		--color-eucalyptus-light: #2D6B53;
		--color-eucalyptus-dark: #123326;
		--color-sage: #527A66;
		--color-sage-light: #8BA888;
		--color-terracotta: #C46D46;
		--color-terracotta-light: #D9855F;
		--color-gold: #D4AF37;
		--color-gold-light: #F3E5AB;
		--color-sand: #EFE8DE;
		--color-sand-light: #FAF7F2;
		--color-charcoal: #191B1A;
		--color-charcoal-light: #2D312E;
		--color-ocean: #3D7B8C;
		--color-ocean-light: #5E98A7;
		
		/* Semantic Colors */
		--color-primary: var(--color-eucalyptus);
		--color-primary-dark: var(--color-eucalyptus-dark);
		--color-primary-light: var(--color-eucalyptus-light);
		--color-accent: var(--color-terracotta);
		--color-accent-light: var(--color-terracotta-light);
		--color-text: var(--color-charcoal);
		--color-text-light: #4D5450;
		--color-text-muted: #7E8782;
		--color-white: #FFFFFF;
		--color-bg: #FAF7F2;
		--color-bg-alt: #F3ECE1;
		--color-bg-dark: var(--color-charcoal);
		--color-card: #FFFFFF;
		--color-border: rgba(25, 27, 26, 0.08);
		--color-border-dark: rgba(25, 27, 26, 0.14);
		
		/* Typography */
		--font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		--font-display: 'Playfair Display', Georgia, serif;
		
		/* Spacing Scale */
		--space-xs: 4px;
		--space-sm: 8px;
		--space-md: clamp(12px, 1.4vw, 16px);
		--space-lg: clamp(18px, 2vw, 24px);
		--space-xl: clamp(24px, 3vw, 32px);
		--space-2xl: clamp(32px, 4.5vw, 48px);
		--space-3xl: clamp(48px, 6vw, 68px);
		--space-4xl: clamp(64px, 9vw, 100px);

		/* Type Scale */
		--text-xs: 0.75rem;
		--text-sm: 0.875rem;
		--text-md: 1rem;
		--text-lg: clamp(1rem, 1.4vw, 1.125rem);
		--text-xl: clamp(1.125rem, 2.2vw, 1.35rem);
		--text-2xl: clamp(1.45rem, 3vw, 2rem);
		--text-3xl: clamp(1.8rem, 4vw, 2.5rem);
		
		/* Layout */
		--max-width: 1280px;
		--max-width-narrow: 760px;
		--header-height: 76px;
		
		/* Borders & Shadows */
		--radius-sm: 8px;
		--radius-md: 14px;
		--radius-lg: 22px;
		--radius-xl: 30px;
		--radius-full: 9999px;
		--shadow-sm: 0 2px 6px rgba(15, 25, 20, 0.04);
		--shadow-md: 0 6px 18px rgba(15, 25, 20, 0.06);
		--shadow-lg: 0 12px 32px rgba(15, 25, 20, 0.08);
		--shadow-xl: 0 20px 50px rgba(15, 25, 20, 0.12);
		--shadow-card: 0 4px 20px rgba(15, 25, 20, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
		--shadow-card-hover: 0 14px 34px rgba(25, 60, 45, 0.12), 0 2px 4px rgba(0, 0, 0, 0.04);
		
		/* Transitions */
		--transition-fast: 150ms cubic-bezier(0.16, 1, 0.3, 1);
		--transition-base: 250ms cubic-bezier(0.16, 1, 0.3, 1);
		--transition-slow: 400ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* Font fallback to prevent FOIT */
	@font-face {
		font-family: 'Inter';
		font-display: swap;
	}
	
	@font-face {
		font-family: 'Playfair Display';
		font-display: swap;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}

	body {
		font-family: var(--font-primary);
		font-size: 16px;
		line-height: 1.7;
		color: var(--color-text);
		background-color: var(--color-bg);
		font-weight: 400;
		letter-spacing: -0.01em;
		overflow-x: clip;
	}

	body.no-scroll {
		overflow: hidden;
	}

	:where(main, section, article, aside, .container, .grid-2, .grid-3, .grid-4) {
		min-width: 0;
	}

	main :where(h1, h2, h3, h4, h5, h6, p, a, li, span, strong) {
		overflow-wrap: anywhere;
	}

	main table,
	main iframe,
	main video,
	main embed,
	main object,
	main canvas {
		max-width: 100%;
	}

	main table {
		display: block;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	main pre {
		max-width: 100%;
		overflow-x: auto;
	}

	a {
		text-decoration: none;
		color: inherit;
		transition: color var(--transition-fast);
	}

	a:hover {
		color: var(--color-accent);
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	input,
	select,
	textarea,
	button {
		font: inherit;
	}

	button,
	a,
	input,
	select,
	textarea {
		touch-action: manipulation;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-display);
		font-weight: 600;
		line-height: 1.2;
		margin-bottom: var(--space-md);
		color: var(--color-text);
		letter-spacing: -0.02em;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
