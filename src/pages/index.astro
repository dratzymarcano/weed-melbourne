		effects: ["Happy", "Relaxed", "Uplifted"],
		flavour: "Mixed Fruit"
	}
];

const steps = [
  { number: "01", title: "Browse Products", desc: "Explore our premium lab-tested range" },
  { number: "02", title: "Add to Cart", desc: "Select your products and quantities" },
  { number: "03", title: "Secure Checkout", desc: "Quick and easy payment options" },
  { number: "04", title: "Fast Delivery", desc: "Discreet shipping Australia-wide" },
];

const featuredProductCards = featuredProducts.map((product) => {
	const resolvedSlug = product.linkSlug ?? product.slug;
	const productData = getProductBySlug(resolvedSlug);
	const canonicalSlug = productData?.slug ?? resolvedSlug;
	const reviewCount = getReviewCount(canonicalSlug);
	const reviewRating = getReviewRating(canonicalSlug);
	const variants = productData ? getWeightVariants(productData.category) : [];
	const variantMultiplier = variants[0]?.multiplier ?? 1;
	const displayPrice = productData ? Math.round(productData.basePrice * variantMultiplier) : product.price;

	return {
		...product,
		resolvedSlug,
		productData,
		canonicalSlug,
		reviewCount,
		reviewRating,
		displayPrice,
	};
});

const stats = [
	{ value: "24-48h", label: "Express Dispatch", sub: "Via AusPost Tracking" },
	{ value: "100%", label: "Smell-Proof", sub: "Double Vacuum-Sealed" },
	{ value: "Bank + BTC", label: "Safe Payment", sub: "PayID, Osko & Crypto" },
	{ value: "30+ Strains", label: "Independently Tested", sub: "Published Cannabinoid COAs" },
];

const categoryLinks = [
	{ href: '/shop/flower/', title: 'Cannabis Flower', detail: 'Premium indica, sativa, and hybrid cultivars with batch lab testing.' },
	{ href: '/shop/thc-gummies/', title: 'THC Gummies', detail: 'Precisely dosed fruit gummies from 5mg micro-dose to 50mg.' },
	{ href: '/shop/edibles/', title: 'Cannabis Edibles', detail: 'Artisanal chocolates, baked treats, and infused beverages.' },
	{ href: '/shop/vapes/', title: 'Vapes & Cartridges', detail: 'Pure distillate & live resin cartridges, 510 batteries, and disposables.' },
];

const proofLinks = [
	{ href: '/shipping-and-delivery/', title: 'Tracked Delivery Standards', description: 'Dispatch windows, discreet packaging, signatures, and location-specific shipping times.' },
	{ href: '/pay-with-bank-transfer/', title: 'Bank Transfer Payments', description: 'Clear payment instructions, support guidance, and secure manual checkout flow.' },
	{ href: '/buy-bitcoin/', title: 'Bitcoin Checkout', description: 'Alternative payment option for customers who prefer crypto checkout.' },
	{ href: '/refunds/', title: 'Returns & Delivery Issues', description: 'What happens when an order is late, damaged, or needs support.' },
];

const intentLinks = [
	{ href: '/faq/', title: 'Cannabis FAQ Australia', detail: 'Clear answers to ordering, shipping, payments, and product questions.' },
	{ href: '/blog/is-weed-legal-in-australia/', title: 'Is Weed Legal in Australia?', detail: 'Comprehensive legal breakdown of federal and state cannabis regulations.' },
	{ href: '/locations/', title: 'Delivery by City', detail: 'Fast, discreet shipping times across all major Australian cities and regions.' },
	{ href: '/contact/#contact-form', title: 'Share Your Experience', detail: 'Submit feedback, order enquiries, or verify customer reviews.' },
];

// websiteSchema (with SearchAction) is emitted globally from src/lib/schema.ts
// via Layout.astro. Do NOT redeclare it here — that would produce two WebSite
// nodes in the same JSON-LD graph.

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Featured Cannabis Products",
  "description": "Top cannabis products available for delivery across Australia",
  "itemListElement": featuredProducts.map((p, index) => {
    const slug = p.linkSlug ?? p.slug;
    return {
      "@type": "ListItem",
      "position": index + 1,
      "name": p.name,
      "url": `https://mullawaysmedicalcannabis.store/shop/product/${slug}/`
    };
  })
};

const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://mullawaysmedicalcannabis.store/#webpage",
  "name": "Buy Weed Online Australia — THC Gummies, Flower & Edibles | Mullaways",
  "url": "https://mullawaysmedicalcannabis.store/",
  "description": "Buy weed online Australia. Lab-tested THC gummies, cannabis flower, edibles & vapes from Mullaways. Discreet AusPost delivery in 2–5 days.",
  "inLanguage": "en-AU",
  "about": {
    "@id": "https://mullawaysmedicalcannabis.store/#organization"
  },
  "isPartOf": { "@id": "https://mullawaysmedicalcannabis.store/#website" },
  // speakable marks content suitable for voice/AI answer engines (AEO/GEO)
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".hero-subtitle", ".section-intro"]
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mullawaysmedicalcannabis.store/" }
    ]
  }
};

const homeFaqs = [
  {
    q: "How do I buy weed online in Australia with Mullaways?",
    a: "Browse our shop, pick your products, and check out as a guest — no account needed. Pay by bank transfer (PayID/Osko) or Bitcoin. You'll get an email confirmation immediately and tracking when it ships."
  },
  {
    q: "How long does weed delivery take to Sydney, Melbourne, Brisbane & regional Australia?",
    a: "Orders ship within 24–48 hours from NSW via AusPost express. Sydney, Melbourne, Brisbane, and Canberra: 2–3 business days. Adelaide, Perth, Hobart, Darwin, and regional areas: 3–5 business days. Tracking updates come to your email."
  },
  {
    q: "Is cannabis delivery completely discreet and smell-proof?",
    a: "Yes. All products are double vacuum-sealed in pharmaceutical-grade barrier bags. Orders ship in plain, unmarked AusPost satchels or cartons — no logos, branding, or product descriptions on the outside."
  },
  {
    q: "What payment methods do you accept for online cannabis orders?",
    a: "Bank transfer (PayID and Osko for instant clearing) and Bitcoin. BTC orders get 10% off automatically. Payment instructions are emailed as soon as you place an order."
  },
  {
    q: "What are the strongest THC gummies and cannabis strains available?",
    a: "Strongest edibles: Ultra Strength 50mg THC Gummies and 25mg THC Gummies. Strongest flower: Gorilla Glue #4 (25–30% THC), Death Bubba (25–27%), Girl Scout Cookies (25–28%), and OG Kush. All products include published lab results."
  },
  {
    q: "Do I need a prescription or an account to order from Mullaways?",
    a: "No. Guest checkout only — no registration, no prescription, no medical card. Products are for responsible adults 18 and older."
  }
];

const homeFaqSchema = faqPageSchema(homeFaqs, 'https://mullawaysmedicalcannabis.store/');
---

<Layout title="Buy Weed Online Australia — THC Gummies, Flower & Edibles | Mullaways" description="Buy weed online Australia. Lab-tested THC gummies, cannabis flower, edibles & vapes from Mullaways. Discreet AusPost delivery in 2–5 days. No prescription needed." schema={[itemListSchema, homePageSchema, homeFaqSchema]}>
	<Header />
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-bg"></div>
			<div class="container">
				<div class="hero-grid">
					<div class="hero-content">
						<div class="hero-badge">
							<span class="badge-dot"></span>
							Australia-Wide Cannabis Delivery & Support
						</div>
						<h1>Buy Weed Online Australia</h1>
						<p class="hero-subtitle">Lab-tested THC gummies, premium flower, edibles & vapes shipped from NSW. Plain packaging, AusPost tracking, 2–5 day delivery to Sydney, Melbourne, Brisbane & everywhere in between.</p>
						
						<div class="hero-ctas">
							<a href="/shop/" class="btn btn-primary btn-large">
								Shop Cannabis Online
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M5 12h14M12 5l7 7-7 7"/>
								</svg>
							</a>
							<a href="/how-it-works/" class="btn btn-outline-light btn-large">How to Buy Weed</a>
						</div>

						<div class="hero-trust-bullets">
							<span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M20 6L9 17l-5-5"/>
								</svg>
								No Prescription Required
							</span>
							<span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M20 6L9 17l-5-5"/>
								</svg>
								100% Smell-Proof Post
							</span>
							<span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M20 6L9 17l-5-5"/>
								</svg>
								AusPost Tracking Included
							</span>
							<span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
									<path d="M20 6L9 17l-5-5"/>
								</svg>
								10% Off with Bitcoin
							</span>
						</div>
					</div>

					<div class="hero-spotlight">
						<div class="spotlight-card">
							<div class="spotlight-badge-row">
								<span class="spotlight-tag">Cultivar Spotlight</span>
								<span class="spotlight-stock"><span class="pulse-dot"></span> In Stock &bull; Express Dispatch</span>
							</div>
							<div class="spotlight-media">
								<img src="/images/products/buy-blue-dream-weed.webp" alt="Blue Dream premium cannabis flower buds" width="360" height="240" loading="eager" />
								<div class="spotlight-overlay-pills">
									<span class="potency-pill">24% THC</span>
									<span class="terpene-pill">AAA+ Top Shelf</span>
								</div>
							</div>
							<div class="spotlight-content">
								<div class="spotlight-meta-header">
									<div>
										<span class="spotlight-category">Hybrid Cultivar</span>
										<h3>Blue Dream</h3>
									</div>
									<div class="spotlight-price">
										<small>From</small>
										<strong>$265</strong>
									</div>
								</div>
								<p class="spotlight-desc">Sweet berry aroma with balanced euphoria and gentle full-body calm. Independently screened for purity.</p>
								<div class="spotlight-chips">
									<span class="chip">Myrcene 1.4%</span>
									<span class="chip">Caryophyllene 0.8%</span>
									<span class="chip">Double Vacuum Pack</span>
								</div>
								<a href="/shop/product/blue-dream/" class="spotlight-cta-btn">
									<span>View Batch Lab Details</span>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M5 12h14M12 5l7 7-7 7"/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				</div>

				<div class="hero-stats">
					{stats.map(stat => (
						<div class="stat-item">
							<span class="stat-value">{stat.value}</span>
							<span class="stat-label">{stat.label}</span>
							{stat.sub && <span class="stat-sub">{stat.sub}</span>}
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Categories Section -->
		<section class="section categories-section">
			<div class="container">
				<div class="section-intro">
					<span class="section-label">Our Products</span>
					<h2>What We Sell</h2>
					<p>Flower, edibles, vapes, concentrates, pre-rolls, and hash — each independently tested for potency and purity before it goes on the site.</p>
				</div>

				<div class="categories-grid">
					{categories.map((cat, i) => (
						<a href={cat.href} class="category-card" style={`--delay: ${i * 0.08}s`}>
							<div class="category-header">
								<span class="category-number">0{i + 1}</span>
								<span class="category-badge">{cat.badge}</span>
							</div>
							<div class="category-body">
								<div class="category-title-group">
									<h3>{cat.name}</h3>
									<span class="category-tagline">{cat.tagline}</span>
								</div>
								<p>{cat.description}</p>
							</div>
							<div class="category-footer">
								<span class="category-count">{cat.count}</span>
								<span class="category-arrow-wrap">
									<span class="category-explore">Shop Now</span>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M7 17L17 7M17 7H7M17 7V17"/>
									</svg>
								</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- Featured Products -->
		<section class="section featured-section">
			<div class="container">
				<div class="section-header-row">
					<div>
						<span class="section-label">Featured</span>
						<h2>Popular Products</h2>
					</div>
					<a href="/shop/" class="btn btn-ghost">
						View All
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>

				<div class="products-grid">
					{featuredProductCards.map((product, i) => {
						const resolvedSlug = product.resolvedSlug;
						const productData = product.productData;
						return (
							<a href={`/shop/product/${resolvedSlug}/`} class="product-card" style={`--delay: ${i * 0.1}s`}>
								<div class="product-badge-group">
									<span class={`product-badge ${product.type.toLowerCase()}`}>{product.type}</span>
									<span class="lab-pill">✓ Batch Tested</span>
								</div>
								<div class="product-image">
									{productData?.image ? (
										<img src={productData.image} alt={getProductImageAlt(productData)} width="360" height="240" loading="lazy" />
									) : (
										<div class="product-placeholder">
											<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
												<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/>
												<path d="M12 6c0 0-4 4-4 8s4 6 4 6 4-2 4-6-4-8-4-8z"/>
											</svg>
										</div>
									)}
								</div>
								<div class="product-content">
									<div class="product-meta">
										<span class="thc">THC {product.thc}</span>
										<span class="meta-dot">&bull;</span>
										<span class="weight">{product.weight}</span>
									</div>
									<h3>{product.name}</h3>
									<div class="product-reviews">
										{product.reviewCount > 0 ? (
											<>
												<span class="rating">★ {product.reviewRating.toFixed(1)}</span>
												<span class="review-count">({product.reviewCount} reviews)</span>
											</>
										) : (
											<span class="review-count">Lab tested batch</span>
										)}
									</div>
									<div class="product-effects">
										{product.effects.map((effect) => (
											<span class="effect-tag">{effect}</span>
										))}
									</div>
									<div class="product-flavour">
										<span class="flavour-label">Notes:</span> {product.flavour}
									</div>
									<div class="product-footer">
										<div class="product-price-col">
											<span class="price-from">From</span>
											<span class="price">${product.displayPrice}</span>
										</div>
										<span class="btn btn-primary btn-sm" data-price={product.displayPrice} data-slug={resolvedSlug}>
											View Options
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
												<path d="M5 12h14M12 5l7 7-7 7"/>
											</svg>
										</span>
									</div>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>

		<section class="section merch-section">
			<div class="container">
				<div class="section-intro">
					<span class="section-label">Quick Links</span>
					<h2>Find What You Need</h2>
					<p>Jump straight to the products, payment info, or support pages you're looking for.</p>
				</div>

				<div class="merch-grid">
					<div class="merch-card">
						<h3>Shop by Category</h3>
						<p class="merch-copy">Browse our full range — flower, edibles, gummies, vapes, and concentrates.</p>
						<ul class="merch-list">
							{categoryLinks.map((link) => (
								<li>
									<a href={link.href}>
										<span>{link.title}</span>
										<small>{link.detail}</small>
									</a>
								</li>
							))}
						</ul>
					</div>

					<div class="merch-card">
						<h3>Delivery & Payment</h3>
						<p class="merch-copy">How we handle payment, shipping, and issues with your order.</p>
						<ul class="merch-list">
							{proofLinks.map((link) => (
								<li>
									<a href={link.href}>
										<span>{link.title}</span>
										<small>{link.description}</small>
									</a>
								</li>
							))}
						</ul>
					</div>

					<div class="merch-card">
						<h3>Helpful Links</h3>
						<p class="merch-copy">Cannabis guides, delivery info, and answers to common questions.</p>
						<ul class="merch-list intent-list">
							{intentLinks.map((link) => (
								<li>
									<a href={link.href}>
										<span>{link.title}</span>
										<small>{link.detail}</small>
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
