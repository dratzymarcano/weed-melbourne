	},
	{
		slug: "Gelato Strain Australia",
		name: "Gelato Strain Australia",
		title: "Gelato Strain Australia",
		linkSlug: "gelato",
		type: "Hybrid",
		thc: "24-26%",
		weight: "28g",
		price: 285,
		description: `Gelato is a flavour-forward hybrid with sweet sherbet, berry, and soft citrus notes. Smooth euphoria with a gradual onset — eases you into relaxation without sedating you. Popular for after-work use.

Start low if you're new to concentrates. Lab-tested for potency and purity.`,
		effects: ["Relaxed", "Euphoric", "Creative"],
