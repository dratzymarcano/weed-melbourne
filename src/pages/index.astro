		letter-spacing: 0.06em;
	}

	.spotlight-meta-header h3 {
		font-family: var(--font-display);
		color: #ffffff;
		font-size: 1.35rem;
		margin: 2px 0 0;
	}

	.spotlight-price {
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.spotlight-price small {
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.7);
		text-transform: uppercase;
	}

	.spotlight-price strong {
		font-size: 1.35rem;
		color: #ffffff;
		font-weight: 700;
		line-height: 1.1;
	}

	.spotlight-desc {
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.82);
		margin-bottom: 14px;
	}

	.spotlight-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 18px;
	}

	.spotlight-chips .chip {
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.14);
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.75rem;
		font-weight: 500;
		padding: 3px 10px;
		border-radius: var(--radius-full);
	}

	.spotlight-cta-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		padding: 12px 20px;
		background: #ffffff;
		color: var(--color-primary-dark);
		border-radius: 12px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.spotlight-cta-btn:hover {
		background: var(--color-terracotta-light);
		color: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
	}

	/* Hero Stats Bento Strip */
	.hero-stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-lg);
		padding: var(--space-xl) var(--space-2xl);
		background: rgba(14, 38, 28, 0.6);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 20px;
		position: relative;
		z-index: 5;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.stat-value {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-white);
		line-height: 1.15;
	}

	.stat-label {
		font-size: 0.9rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.95);
		letter-spacing: 0.02em;
	}

	.stat-sub {
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.7);
	}

	/* ========== Section Styles ========== */
	.section-intro {
		max-width: 640px;
		margin-bottom: var(--space-3xl);
	}

	.section-intro h2 {
		margin-bottom: var(--space-md);
	}

	.section-intro p {
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.section-intro-light h2 {
		color: var(--color-white);
	}

	.section-intro-light p {
		color: rgba(255, 255, 255, 0.8);
	}

	.section-intro-light .section-label {
		color: var(--color-terracotta-light);
	}

	.section-intro-light .section-label::before {
		background: var(--color-terracotta-light);
	}

	.section-header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: var(--space-2xl);
		gap: var(--space-lg);
	}

	.section-header-row h2 {
		margin-bottom: 0;
	}

	/* ========== Categories Section ========== */
	.categories-section {
		background: var(--color-bg);
		padding: var(--space-4xl) 0;
	}

	.categories-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-xl);
	}

	.category-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
		background: #FFFFFF;
		border-radius: var(--radius-xl);
		padding: var(--space-2xl);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		border: 1px solid rgba(31, 77, 60, 0.08);
		box-shadow: 0 4px 20px rgba(15, 25, 20, 0.03);
		text-decoration: none;
		color: inherit;
		overflow: hidden;
	}

	.category-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-terracotta));
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.category-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 16px 36px rgba(31, 77, 60, 0.12);
		border-color: rgba(31, 77, 60, 0.22);
	}

	.category-card:hover::before {
		opacity: 1;
	}

	.category-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-lg);
	}

	.category-number {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		color: rgba(31, 77, 60, 0.25);
		line-height: 1;
	}

	.category-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 4px 10px;
		border-radius: var(--radius-full);
		background: rgba(31, 77, 60, 0.08);
		color: var(--color-primary);
	}

	.category-body {
		margin-bottom: var(--space-xl);
	}

	.category-title-group h3 {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 4px;
	}

	.category-tagline {
		display: block;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-terracotta);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: var(--space-sm);
	}

	.category-body p {
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--color-text-muted);
		margin: 0;
	}

	.category-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: var(--space-md);
		border-top: 1px solid rgba(31, 77, 60, 0.06);
	}

	.category-count {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.category-arrow-wrap {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-primary);
		transition: all 0.2s ease;
	}

	.category-card:hover .category-arrow-wrap {
		color: var(--color-terracotta);
		transform: translateX(4px);
	}

	/* ========== Featured Products ========== */
	.featured-section {
		background: var(--color-white);
		padding: var(--space-4xl) 0;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-xl);
	}

	a.product-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}

	.product-card {
		background: #FFFFFF;
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(15, 25, 20, 0.04);
		border: 1px solid rgba(31, 77, 60, 0.08);
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
		position: relative;
	}

	.product-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 18px 40px rgba(31, 77, 60, 0.12);
		border-color: rgba(31, 77, 60, 0.2);
	}

	.product-badge-group {
		position: absolute;
		top: 14px;
		left: 14px;
		right: 14px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		z-index: 2;
	}

	.product-badge {
		padding: 5px 12px;
		border-radius: var(--radius-full);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		background: #f59e0b;
		color: white;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
	}

	.product-badge.indica {
		background: #7c3aed;
	}

	.product-badge.sativa {
		background: #d97706;
	}

	.product-badge.hybrid {
		background: #059669;
	}

	.product-badge.edible {
		background: #c46d46;
	}

	.lab-pill {
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		color: var(--color-primary-dark);
		font-size: 0.7rem;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(31, 77, 60, 0.1);
	}

	.product-image {
		height: 220px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(180deg, #FAF7F2 0%, #F0EAE1 100%);
		position: relative;
		overflow: hidden;
	}

	.product-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.product-card:hover .product-image img {
		transform: scale(1.06);
	}

	.product-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
		opacity: 0.4;
	}

	.product-content {
		padding: 22px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.product-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.85rem;
		margin-bottom: 8px;
	}

	.product-meta .thc {
		font-weight: 700;
		color: var(--color-primary);
	}

	.product-meta .meta-dot {
		color: rgba(31, 77, 60, 0.3);
	}

	.product-meta .weight {
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.product-content h3 {
		font-family: var(--font-display);
		font-size: 1.18rem;
		font-weight: 700;
		line-height: 1.35;
		margin-bottom: 8px;
		color: var(--color-text);
	}

	.product-reviews {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		margin-bottom: 12px;
	}

	.product-reviews .rating {
		font-weight: 700;
		color: #D4AF37;
	}

	.product-reviews .review-count {
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.product-effects {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 12px;
	}

	.effect-tag {
		background: rgba(31, 77, 60, 0.05);
		border: 1px solid rgba(31, 77, 60, 0.1);
		padding: 4px 10px;
		border-radius: var(--radius-full);
		font-size: 0.78rem;
		color: var(--color-text);
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.product-card:hover .effect-tag {
		border-color: rgba(31, 77, 60, 0.2);
		background: rgba(31, 77, 60, 0.08);
	}

	.product-flavour {
		font-size: 0.84rem;
		color: var(--color-text-muted);
		margin-bottom: 18px;
		line-height: 1.5;
	}

	.product-flavour .flavour-label {
		font-weight: 600;
		color: var(--color-text);
	}

	.product-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 16px;
		border-top: 1px solid rgba(31, 77, 60, 0.07);
		margin-top: auto;
	}

	.product-price-col {
		display: flex;
		flex-direction: column;
	}

	.price-from {
		font-size: 0.72rem;
		text-transform: uppercase;
		color: var(--color-text-muted);
		font-weight: 600;
		letter-spacing: 0.05em;
	}

	.price {
		font-size: 1.45rem;
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.1;
	}

	.product-footer .btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 10px 18px;
		font-size: 0.88rem;
		font-weight: 600;
		border-radius: var(--radius-full);
		background: var(--color-primary);
		color: #ffffff;
		border: none;
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.product-footer .btn:hover {
		background: var(--color-primary-dark);
		transform: translateY(-2px);
		box-shadow: 0 4px 14px rgba(31, 77, 60, 0.3);
	}

	.merch-section {
		background: var(--color-sand);
	}

	.merch-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-lg);
	}

	.merch-card {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-xl);
		box-shadow: var(--shadow-sm);
	}

	.merch-card h3 {
		margin-bottom: var(--space-sm);
	}

	.merch-copy {
		font-size: 0.95rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-lg);
	}

	.merch-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.merch-list li a {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 14px 16px;
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-text);
		text-decoration: none;
		transition: all var(--transition-base);
	}

	.merch-list li a:hover {
		background: rgba(45, 90, 74, 0.08);
		transform: translateX(3px);
	}

	.merch-list li span {
		font-weight: 600;
	}

	.merch-list li small {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	/* ========== Process Section ========== */
	.process-section {
		position: relative;
		background: var(--color-primary-dark);
		overflow: hidden;
	}

	.process-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.process-shape {
		position: absolute;
		width: 500px;
		height: 500px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.05);
		right: -200px;
		top: 50%;
		transform: translateY(-50%);
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-xl);
		position: relative;
	}

	.process-step {
		position: relative;
		padding: var(--space-xl);
		background: rgba(255, 255, 255, 0.05);
		border-radius: var(--radius-lg);
		backdrop-filter: blur(10px);
	}

	.step-number {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--color-terracotta);
		margin-bottom: var(--space-md);
	}

	.process-step h3 {
		color: var(--color-white);
		font-size: 1.15rem;
		margin-bottom: var(--space-sm);
	}

	.process-step p {
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.95rem;
		margin: 0;
	}

	.process-cta {
		text-align: center;
		margin-top: var(--space-3xl);
		position: relative;
		z-index: 10;
	}

	.process-cta .btn {
		pointer-events: auto;
		cursor: pointer;
	}

	/* ========== Trust Section ========== */
	.trust-section {
		background: var(--color-bg);
	}

	.trust-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4xl);
		align-items: center;
	}

	.trust-content h2 {
		margin-bottom: var(--space-md);
	}

	.trust-content > p {
		font-size: 1.1rem;
		margin-bottom: var(--space-2xl);
	}

	.trust-features {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.trust-features li {
		display: flex;
		gap: var(--space-md);
		align-items: flex-start;
	}

	.feature-icon {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-white);
		border-radius: var(--radius-md);
		color: var(--color-primary);
		box-shadow: var(--shadow-sm);
	}

	.trust-features li div {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.trust-features li strong {
		font-weight: 600;
		color: var(--color-text);
	}

	.trust-features li span {
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}

	.proof-links-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md);
		margin-top: var(--space-2xl);
	}

	.proof-link-card {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: var(--space-lg);
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: var(--color-text);
		transition: all var(--transition-base);
	}

	.proof-link-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: rgba(45, 90, 74, 0.2);
	}

	.proof-link-card strong {
		font-size: 0.95rem;
	}

	.proof-link-card span {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.trust-visual {
		display: flex;
		justify-content: center;
	}

	.trust-image {
		width: 100%;
		max-width: 480px;
		height: auto;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-xl);
		object-fit: cover;
		aspect-ratio: 1;
	}

	/* ========== Testimonials ========== */
	.testimonials-section {
		background: var(--color-white);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-lg);
	}

	.testimonials-header {
		align-items: center;
	}

	.testimonial-card {
		background: var(--color-bg);
		border-radius: var(--radius-lg);
		padding: var(--space-xl);
		border: 1px solid var(--color-border);
		margin: 0;
		transition: all var(--transition-base);
	}

	.testimonial-card:hover {
		box-shadow: var(--shadow-md);
	}

	.testimonial-card.featured {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
		border-color: transparent;
		transform: scale(1.02);
	}

	.testimonial-card.featured p {
		color: rgba(255, 255, 255, 0.95);
	}

	.testimonial-card.featured footer strong {
		color: var(--color-white);
	}

	.testimonial-card.featured footer span {
		color: rgba(255, 255, 255, 0.7);
	}

	.testimonial-card.featured .testimonial-rating svg {
		color: var(--color-terracotta-light);
	}

	.testimonial-rating {
		display: flex;
		gap: 2px;
		margin-bottom: var(--space-md);
		color: var(--color-terracotta);
	}

	.testimonial-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-sm);
		margin-bottom: var(--space-md);
		flex-wrap: wrap;
	}

	.verified-badge {
		display: inline-flex;
		align-items: center;
		padding: 6px 10px;
		border-radius: var(--radius-full);
		background: rgba(45, 90, 74, 0.08);
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.testimonial-product {
		font-size: 0.85rem;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
	}

	.testimonial-product:hover {
		text-decoration: underline;
	}

	.testimonial-card.featured .verified-badge {
		background: rgba(255, 255, 255, 0.12);
		color: var(--color-white);
