            dateReviewed="September 20, 2026"
            sources={[
              { title: "Therapeutic Goods Administration — Vaping Hub & Device Regulations", url: "https://www.tga.gov.au/products/unapproved-therapeutic-goods/vaping-hub" },
              { title: "Australian Register of Therapeutic Goods (ARTG) — Medical Vaporisers", url: "https://www.tga.gov.au/resources/artg" },
              { title: "International Journal of Drug Policy — Health Impacts of Cannabis Vaporization", url: "https://www.sciencedirect.com/journal/international-journal-of-drug-policy" }
