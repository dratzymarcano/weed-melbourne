---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="Shopping Cart | Mullaways Medical Cannabis" description="Review your cannabis order. Buy weed online Australia with secure checkout. Pay with Bitcoin or bank transfer. Discreet shipping." noindex={true}>
  <Header />
  
  <main>
    <Breadcrumb items={[{label: 'Home', href: '/'}, {label: 'Cart'}]} />
    <!-- Hero Section -->
    <section class="page-hero">
      <div class="hero-bg">
        <div class="hero-shape hero-shape-1"></div>
        <div class="hero-shape hero-shape-2"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <h1>Shopping Cart</h1>
          <p>Review your items and proceed to checkout</p>
        </div>
      </div>
    </section>

    <!-- Cart Section -->
    <section class="section cart-section">
      <div class="container">
        <div class="cart-layout">
          <!-- Cart Items -->
          <div class="cart-items" id="cart-items">
            <div class="empty-cart" id="empty-cart">
              <div class="empty-icon"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></div>
              <h2>Your cart is empty</h2>
              <p>Looks like you haven't added any products yet. Browse our premium selection of cannabis products.</p>
              <a href="/shop/" class="btn btn-primary btn-large">Browse Products</a>
            </div>
            
            <!-- Cart items will be populated by JavaScript -->
            <div class="cart-list" id="cart-list" style="display: none;">
              <!-- Dynamic cart items go here -->
            </div>
          </div>

          <!-- Cart Summary -->
          <div class="cart-summary" id="cart-summary" style="display: none;">
            <div class="summary-card">
              <h3>Order Summary</h3>
              
              <div class="summary-row">
                <span>Subtotal</span>
                <span id="cart-subtotal">$0.00</span>
              </div>

              <div class="summary-row" id="cart-discount-row" style="display: none;">
                <span style="color:#059669;font-weight:600;" id="cart-discount-label">Promo Discount</span>
                <span id="cart-discount" style="color:#059669;font-weight:600;">-$0.00</span>
              </div>
              
              <div class="summary-row">
                <span>Estimated Shipping</span>
                <span id="cart-shipping">Calculated at checkout</span>
              </div>
              
              <div class="summary-divider"></div>
              
              <div class="summary-row summary-total">
                <span>Total</span>
                <span id="cart-total">$0.00</span>
              </div>

              <div class="cart-loyalty-callout" id="cart-loyalty-callout">
                <span class="loyalty-icon">⭐</span>
                <span>You will earn <strong id="cart-loyalty-pts">0</strong> Mullaways Loyalty Points on this order</span>
              </div>

              <div class="promo-section">
                <label for="promo-code">Promo Code</label>
                <div class="promo-input">
                  <input type="text" id="promo-code" placeholder="e.g. WELCOME15" style="text-transform: uppercase;">
                  <button type="button" class="btn btn-outline btn-sm" id="apply-promo-btn">Apply</button>
                </div>
                <div id="promo-message" style="display: none; margin-top: 8px; font-size: 0.85rem; line-height: 1.4;"></div>
              </div>
              
              <a href="/checkout/" class="btn btn-primary btn-large btn-full" id="checkout-btn">
                Proceed to Checkout
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
              
              <p class="secure-note">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                Secure checkout with encrypted payment
              </p>
            </div>

            <!-- 100% Delivery Guarantee Card -->
            <div class="cart-guarantee-box">
              <div class="cart-guarantee-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="cart-guarantee-text">
                <strong>100% Guaranteed Safe Delivery</strong>
                <p>Triple smell-proof vacuum sealed &amp; tracked Australia Post Express. Guaranteed safe arrival or immediate 100% free reshipment.</p>
              </div>
            </div>

            <div class="trust-badges">
              <div class="badge">
                <span class="badge-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                <span>Secure Payment</span>
              </div>
              <div class="badge">
                <span class="badge-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
                <span>Discreet Packaging</span>
              </div>
              <div class="badge">
                <span class="badge-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
                <span>Fast Delivery</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Continue Shopping -->
    <section class="section continue-section">
      <div class="container">
        <div class="continue-card">
          <h2>Continue Shopping</h2>
          <p>Explore our full range of premium cannabis products</p>
          <div class="category-links">
            <a href="/shop/flower/" class="category-link">
              <span class="link-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/><path d="M12 6c0 0-4 4-4 8s4 6 4 6 4-2 4-6-4-8-4-8z"/></svg></span>
              <span>Cannabis Flower</span>
            </a>
            <a href="/shop/concentrates/" class="category-link">
              <span class="link-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg></span>
              <span>Concentrates</span>
            </a>
            <a href="/shop/edibles/" class="category-link">
              <span class="link-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></span>
              <span>Edibles</span>
            </a>
            <a href="/shop/thc-gummies/" class="category-link">
              <span class="link-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="3"/></svg></span>
              <span>THC Gummies</span>
            </a>
            <a href="/shop/vapes/" class="category-link">
              <span class="link-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 19H5c-1 0-2-1-2-2V7c0-1 1-2 2-2h14c1 0 2 1 2 2v10c0 1-1 2-2 2h-3"/><path d="M12 15v4"/><circle cx="12" cy="9" r="3"/></svg></span>
              <span>Vapes</span>
            </a>
            <a href="/shop/pre-rolls/" class="category-link">
              <span class="link-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20"/><path d="M8 6l4-4 4 4"/><circle cx="12" cy="12" r="3"/></svg></span>
              <span>Pre-Rolls</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, var(--color-eucalyptus-dark) 0%, var(--color-eucalyptus) 100%);
    padding: var(--space-3xl) 0;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
  }

  .hero-shape-1 {
    width: 400px;
    height: 400px;
    top: -100px;
    right: -100px;
  }

  .hero-shape-2 {
    width: 300px;
    height: 300px;
    bottom: -50px;
    left: -50px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .section-label-light {
    color: rgba(255, 255, 255, 0.8);
  }

  .section-label-light::before {
    background: rgba(255, 255, 255, 0.5);
  }

  .page-hero h1 {
    color: white;
    margin-bottom: var(--space-md);
  }

  .page-hero p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.125rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* Cart Section */
  .cart-section {
    background: var(--color-bg);
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Empty Cart */
  .empty-cart {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: var(--space-lg);
  }

  .empty-cart h2 {
    margin-bottom: var(--space-md);
  }

  .empty-cart p {
    max-width: 400px;
    margin: 0 auto var(--space-xl);
  }

  /* Cart List */
  .cart-list {
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 100px 1fr auto auto;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item:last-child {
    border-bottom: none;
  }

  .item-image {
    width: 100px;
    height: 100px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .item-details h4 {
    font-family: var(--font-primary);
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .item-variant {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .item-price {
    font-weight: 600;
    color: var(--color-primary);
  }

  .quantity-control {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--color-bg-alt);
    border-radius: var(--radius-full);
    padding: 4px;
  }

  .qty-btn {
    width: 44px;
    height: 44px;
    border: none;
    background: white;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    transition: all var(--transition-fast);
  }

  .qty-btn:hover {
    background: var(--color-primary);
    color: white;
  }

  .qty-value {
    min-width: 30px;
    text-align: center;
    font-weight: 500;
  }

  .remove-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-sm);
    transition: color var(--transition-fast);
  }

  .remove-btn:hover {
    color: #e74c3c;
  }

  /* Cart Summary */
  .summary-card {
    background: white;
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }

  .summary-card h3 {
    margin-bottom: var(--space-lg);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-sm) 0;
    color: var(--color-text-light);
  }

  .summary-total {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .summary-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-md) 0;
  }

  .promo-section {
    margin: var(--space-lg) 0;
  }

  .promo-section label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .promo-input {
    display: flex;
    gap: var(--space-sm);
  }

  .promo-input input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
  }

  .btn-full {
    width: 100%;
  }

  .secure-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: var(--space-md);
    margin-bottom: 0;
  }

  .cart-loyalty-callout {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    margin: var(--space-sm) 0 var(--space-md);
    font-size: 0.85rem;
    color: #92400e;
    line-height: 1.4;
  }

  .cart-loyalty-callout .loyalty-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .cart-guarantee-box {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-md);
    margin-top: var(--space-md);
  }

  .cart-guarantee-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cart-guarantee-text strong {
    display: block;
    font-size: 0.88rem;
    color: #166534;
    margin-bottom: 2px;
  }

  .cart-guarantee-text p {
    font-size: 0.78rem;
    color: #15803d;
    line-height: 1.4;
    margin: 0;
  }

  /* Trust Badges */
  .trust-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .trust-badges .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: white;
    border-radius: var(--radius-md);
    text-align: center;
  }

  .badge-icon {
    font-size: 1.25rem;
  }

  .trust-badges .badge span:last-child {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* Continue Shopping */
  .continue-section {
    background: white;
  }

  .continue-card {
    text-align: center;
  }

  .continue-card h2 {
    margin-bottom: var(--space-sm);
  }

  .continue-card > p {
    margin-bottom: var(--space-xl);
  }

  .category-links {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .category-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .category-link:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-4px);
  }

  .link-icon {
    font-size: 1.5rem;
  }

  @media (max-width: 900px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }

    .cart-item {
      grid-template-columns: 80px 1fr;
      gap: var(--space-md);
    }

    .item-price,
    .quantity-control {
      grid-column: 2;
    }

    .social-login-buttons {
      grid-template-columns: 1fr;
    }

    .promo-input {
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .page-hero h1 {
      font-size: 1.75rem;
    }

    .cart-item {
      grid-template-columns: 70px 1fr;
      gap: var(--space-sm);
      padding: var(--space-md);
    }

    .item-image {
      width: 70px;
      height: 70px;
    }

    .item-details h4 {
      font-size: 0.9rem;
    }

    .quantity-control {
      gap: var(--space-xs);
      width: fit-content;
    }

    .item-price,
    .quantity-control,
    .remove-btn {
      grid-column: 2;
    }

    .remove-btn {
      justify-self: flex-start;
      padding-left: 0;
    }

    .summary-card {
      padding: var(--space-md);
    }

    .trust-badges {
      grid-template-columns: 1fr;
    }

    .category-links {
      flex-direction: column;
    }

    .category-link {
      flex-direction: row;
      justify-content: flex-start;
    }

    .promo-input .btn {
      width: 100%;
    }

  }
</style>

<script>
  // Cart functionality
  function renderCart() {
    let cart = JSON.parse(localStorage.getItem('cart') || '[]');
    
    // Clean up invalid cart items (no name or undefined)
    const cleanedCart = cart.filter((item: any) => item.name && item.name !== 'undefined');
    if (cleanedCart.length !== cart.length) {
      localStorage.setItem('cart', JSON.stringify(cleanedCart));
      cart = cleanedCart;
      window.dispatchEvent(new CustomEvent('cartUpdated'));
    }
    
    const emptyCart = document.getElementById('empty-cart');
    const cartList = document.getElementById('cart-list');
    const cartSummary = document.getElementById('cart-summary');

    if (cart.length === 0) {
      if (emptyCart) emptyCart.style.display = 'block';
      if (cartList) cartList.style.display = 'none';
      if (cartSummary) cartSummary.style.display = 'none';
    } else {
      if (emptyCart) emptyCart.style.display = 'none';
      if (cartList) {
        cartList.style.display = 'block';
        const defaultIcon = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/><path d="M12 6c0 0-4 4-4 8s4 6 4 6 4-2 4-6-4-8-4-8z"/></svg>';
        cartList.innerHTML = cart.map((item: any, index: number) => `
          <div class="cart-item" data-index="${index}">
            <div class="item-image">${item.icon || defaultIcon}</div>
            <div class="item-details">
              <h4>${item.name || 'Unknown Product'}</h4>
              <p class="item-variant">${item.variant || ''}</p>
              <p class="item-price">$${(item.price * item.quantity).toFixed(2)}</p>
            </div>
            <div class="quantity-control">
              <button class="qty-btn qty-minus" data-index="${index}">−</button>
              <span class="qty-value">${item.quantity}</span>
              <button class="qty-btn qty-plus" data-index="${index}">+</button>
            </div>
            <button class="remove-btn" data-index="${index}" aria-label="Remove item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        `).join('');

        // Add event listeners
        cartList.querySelectorAll('.qty-minus').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
            updateQuantity(index, -1);
          });
        });

        cartList.querySelectorAll('.qty-plus').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
            updateQuantity(index, 1);
          });
        });

        cartList.querySelectorAll('.remove-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const index = parseInt((e.currentTarget as HTMLElement).dataset.index || '0');
            removeItem(index);
          });
        });
      }
      if (cartSummary) {
        cartSummary.style.display = 'block';
        const subtotal = cart.reduce((sum: number, item: any) => sum + (item.price * item.quantity), 0);
        const subtotalEl = document.getElementById('cart-subtotal');
        const shippingEl = document.getElementById('cart-shipping');
        const discountRow = document.getElementById('cart-discount-row');
        const discountLabel = document.getElementById('cart-discount-label');
        const discountEl = document.getElementById('cart-discount');
        const totalEl = document.getElementById('cart-total');

        if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;

        // Dynamic Shipping calculation display
        if (shippingEl) {
          if (subtotal >= 150) {
            shippingEl.innerHTML = '<strong style="color:#059669;">FREE</strong> (Orders over $150)';
          } else {
            const diff = (150 - subtotal).toFixed(2);
            shippingEl.textContent = `$9.95 (Add $${diff} for FREE standard delivery)`;
          }
        }

        // Promo Discount
        let appliedPromo: { code: string; rate: number; label: string } | null = null;
        try {
          const storedPromo = localStorage.getItem('appliedPromo');
          if (storedPromo) appliedPromo = JSON.parse(storedPromo);
        } catch {
          appliedPromo = null;
        }

        let promoDiscount = 0;
        if (appliedPromo && appliedPromo.rate > 0) {
          promoDiscount = Math.round(subtotal * appliedPromo.rate * 100) / 100;
          if (discountRow && discountLabel && discountEl) {
            discountRow.style.display = 'flex';
            discountLabel.textContent = `Promo (${appliedPromo.code}) -${Math.round(appliedPromo.rate * 100)}%`;
            discountEl.textContent = `-$${promoDiscount.toFixed(2)}`;
          }
        } else if (discountRow) {
          discountRow.style.display = 'none';
        }

        const grandTotal = Math.max(0, subtotal - promoDiscount);
        if (totalEl) totalEl.textContent = `$${grandTotal.toFixed(2)}`;

        const loyaltyEl = document.getElementById('cart-loyalty-pts');
        if (loyaltyEl) loyaltyEl.textContent = Math.round(grandTotal).toString();

        // Render Promo input state
        renderPromoStatus(appliedPromo);
      }
    }
  }

  const VALID_PROMOS: Record<string, { rate: number; label: string }> = {
    'WELCOME15': { rate: 0.15, label: '15% Off First Order' },
    'FIRST15': { rate: 0.15, label: '15% Off First Order' },
    'MULLAWAYS15': { rate: 0.15, label: '15% Off First Order' },
    'SAVE10': { rate: 0.10, label: '10% Off' },
  };

  function renderPromoStatus(appliedPromo: { code: string; rate: number; label: string } | null) {
    const promoInput = document.getElementById('promo-code') as HTMLInputElement | null;
    const promoMsg = document.getElementById('promo-message');
    const applyBtn = document.getElementById('apply-promo-btn');

    if (!promoMsg) return;

    if (appliedPromo) {
      if (promoInput) {
        promoInput.value = appliedPromo.code;
        promoInput.disabled = true;
      }
      if (applyBtn) {
        applyBtn.textContent = 'Remove';
        applyBtn.classList.remove('btn-outline');
        applyBtn.classList.add('btn-ghost');
      }
      promoMsg.style.display = 'block';
      promoMsg.style.color = '#059669';
      promoMsg.innerHTML = `✓ Code <strong>${appliedPromo.code}</strong> applied (${Math.round(appliedPromo.rate * 100)}% off).`;
    } else {
      if (promoInput) {
        promoInput.disabled = false;
      }
      if (applyBtn) {
        applyBtn.textContent = 'Apply';
        applyBtn.classList.remove('btn-ghost');
        applyBtn.classList.add('btn-outline');
      }
    }
  }

  function handlePromoApply() {
    const promoInput = document.getElementById('promo-code') as HTMLInputElement | null;
    const promoMsg = document.getElementById('promo-message');
    const storedPromo = localStorage.getItem('appliedPromo');

    if (storedPromo) {
      // User clicked Remove
      localStorage.removeItem('appliedPromo');
      if (promoInput) promoInput.value = '';
      if (promoMsg) {
        promoMsg.style.display = 'none';
        promoMsg.textContent = '';
      }
      renderCart();
      return;
    }

    if (!promoInput || !promoMsg) return;
    const code = promoInput.value.trim().toUpperCase();

    if (!code) {
      promoMsg.style.display = 'block';
      promoMsg.style.color = '#dc2626';
      promoMsg.textContent = 'Please enter a promo code.';
      return;
    }

    if (VALID_PROMOS[code]) {
      const promoInfo = VALID_PROMOS[code];
      localStorage.setItem('appliedPromo', JSON.stringify({
        code,
        rate: promoInfo.rate,
        label: promoInfo.label
      }));
      promoMsg.style.display = 'block';
      promoMsg.style.color = '#059669';
      promoMsg.innerHTML = `✓ Code <strong>${code}</strong> applied (${Math.round(promoInfo.rate * 100)}% off).`;
      renderCart();
    } else {
      promoMsg.style.display = 'block';
      promoMsg.style.color = '#dc2626';
      promoMsg.innerHTML = 'Invalid code. Use <strong>WELCOME15</strong> for 15% off your order.';
    }
  }

  document.getElementById('apply-promo-btn')?.addEventListener('click', handlePromoApply);
  document.getElementById('promo-code')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handlePromoApply();
    }
  });

  function updateQuantity(index: number, delta: number) {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    if (cart[index]) {
      cart[index].quantity = Math.max(1, cart[index].quantity + delta);
      localStorage.setItem('cart', JSON.stringify(cart));
      renderCart();
      window.dispatchEvent(new Event('cartUpdated'));
    }
  }

  function removeItem(index: number) {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    cart.splice(index, 1);
    localStorage.setItem('cart', JSON.stringify(cart));
    renderCart();
    window.dispatchEvent(new Event('cartUpdated'));
  }

  // Initial render
  renderCart();

  // Listen for updates
  window.addEventListener('storage', renderCart);
  window.addEventListener('cartUpdated', renderCart);
</script>
