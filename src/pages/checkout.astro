---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="Secure Checkout | Mullaways Medical Cannabis" description="Complete your medical cannabis order securely. 3-step progressive checkout. Discreet Australia-wide delivery with tracked express shipping." noindex={true}>
  <Header />

  <main>
    <!-- Bitcoin Discount Banner -->
    <div class="btc-promo-bar">
      <div class="container btc-promo-inner">
        <svg width="18" height="18" viewBox="0 0 64 64" style="flex-shrink:0;"><circle cx="32" cy="32" r="32" fill="#F7931A"/><path d="M46.1 27.4c.6-4.2-2.6-6.5-7-8l1.4-5.7-3.5-.9-1.4 5.5c-.9-.2-1.9-.4-2.8-.7l1.4-5.5-3.5-.9-1.4 5.7c-.8-.2-1.5-.3-2.2-.5l0 0-4.8-1.2-.9 3.7s2.6.6 2.5.6c1.4.4 1.7 1.3 1.6 2l-1.6 6.6c.1 0 .2 0 .3.1l-.3-.1-2.3 9.2c-.2.4-.6 1.1-1.6.8 0 0-2.5-.6-2.5-.6l-1.7 4 4.5 1.1c.8.2 1.7.4 2.5.6l-1.5 5.8 3.5.9 1.4-5.7c1 .3 1.9.5 2.8.7l-1.4 5.7 3.5.9 1.5-5.8c5.8 1.1 10.2.7 12-4.6 1.5-4.3-.1-6.7-3.2-8.3 2.2-.5 3.9-2 4.4-5.1zm-7.8 10.9c-1.1 4.3-8.2 2-10.5 1.4l1.9-7.5c2.3.6 9.7 1.7 8.6 6.1zm1-11c-1 3.9-6.9 1.9-8.8 1.4l1.7-6.8c1.9.5 8.2 1.4 7.1 5.4z" fill="#FFF"/></svg>
        <span><strong>Save 10%</strong> when you pay with Bitcoin &mdash; discount applied automatically at checkout</span>
        <a href="/buy-bitcoin/" class="btc-promo-link">Learn more &rarr;</a>
      </div>
    </div>

    <Breadcrumb items={[{label: 'Home', href: '/'}, {label: 'Cart', href: '/cart/'}, {label: 'Checkout'}]} />
    
    <section class="page-hero">
      <div class="hero-bg">
        <div class="hero-shape hero-shape-1"></div>
        <div class="hero-shape hero-shape-2"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <h1>Secure Checkout</h1>
          <p>Follow our simple 3-step checkout to finalise your order and arrange fast delivery.</p>
        </div>
      </div>
    </section>

    <section class="section checkout-section">
      <div class="container">
        <div class="checkout-layout" id="checkout-layout">
          
          <!-- Progressive Stepper & Left Column -->
          <div class="checkout-main-col">
            
            <!-- 3-Step Indicator Bar -->
            <div class="checkout-stepper" id="checkout-stepper" role="navigation" aria-label="Checkout Progress">
              
              <button type="button" class="step-indicator active" id="step-nav-1" data-step-target="1" aria-current="step">
                <span class="step-bubble">
                  <span class="step-num">1</span>
                  <svg class="step-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span class="step-meta">
                  <span class="step-small-title">Step 1</span>
                  <span class="step-label">Customer Info</span>
                </span>
              </button>

              <div class="step-connector" id="connector-1"></div>

              <button type="button" class="step-indicator" id="step-nav-2" data-step-target="2">
                <span class="step-bubble">
                  <span class="step-num">2</span>
                  <svg class="step-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span class="step-meta">
                  <span class="step-small-title">Step 2</span>
                  <span class="step-label">Shipping / Delivery</span>
                </span>
              </button>

              <div class="step-connector" id="connector-2"></div>

              <button type="button" class="step-indicator" id="step-nav-3" data-step-target="3">
                <span class="step-bubble">
                  <span class="step-num">3</span>
                  <svg class="step-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span class="step-meta">
                  <span class="step-small-title">Step 3</span>
                  <span class="step-label">Payment</span>
                </span>
              </button>

            </div>

            <!-- ── STEP 1: Customer Information ── -->
            <div class="step-pane active" id="step-pane-1">
              <div class="card checkout-card">
                <div class="card-header-row">
                  <div>
                    <span class="card-step-tag">Step 1 of 3</span>
                    <h2>Customer &amp; Delivery Information</h2>
                    <p class="card-step-desc">Enter your contact info and recipient address. Packed in plain, 100% smell-proof satchels with zero cannabis branding.</p>
                  </div>
                </div>

                <form class="form-grid" id="checkout-details" novalidate>
                  <div class="form-group">
                    <label for="firstName">First Name <span class="required-star">*</span></label>
                    <input type="text" id="firstName" name="firstName" placeholder="First name" autocomplete="given-name" required>
                  </div>
                  <div class="form-group">
                    <label for="lastName">Last Name <span class="required-star">*</span></label>
                    <input type="text" id="lastName" name="lastName" placeholder="Last name" autocomplete="family-name" required>
                  </div>
                  <div class="form-group">
                    <label for="email">Email Address <span class="required-star">*</span></label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
                    <span class="field-hint">Order confirmation &amp; tracking number will be sent here</span>
                  </div>
                  <div class="form-group">
                    <label for="phone">Phone Number <span class="required-star">*</span></label>
                    <input type="tel" id="phone" name="phone" placeholder="0400 000 000" autocomplete="tel" required>
                    <span class="field-hint">For Australia Post delivery SMS alerts only</span>
                  </div>
                  <div class="form-group full">
                    <label for="address">Street Address <span class="required-star">*</span></label>
                    <input type="text" id="address" name="address" placeholder="Unit, street number and street name" autocomplete="street-address" required>
                  </div>
                  <div class="form-group">
                    <label for="city">City / Suburb <span class="required-star">*</span></label>
                    <input type="text" id="city" name="city" placeholder="City or Suburb" autocomplete="address-level2" required>
                  </div>
                  <div class="form-group">
                    <label for="state">State / Territory <span class="required-star">*</span></label>
                    <select id="state" name="state" required class="select-input">
                      <option value="">Select state...</option>
                      <option value="NSW">New South Wales (NSW)</option>
                      <option value="VIC">Victoria (VIC)</option>
                      <option value="QLD">Queensland (QLD)</option>
                      <option value="WA">Western Australia (WA)</option>
                      <option value="SA">South Australia (SA)</option>
                      <option value="ACT">Australian Capital Territory (ACT)</option>
                      <option value="TAS">Tasmania (TAS)</option>
                      <option value="NT">Northern Territory (NT)</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="postcode">Postcode <span class="required-star">*</span></label>
                    <input type="text" id="postcode" name="postcode" placeholder="4-digit postcode (e.g. 3000)" maxlength="4" autocomplete="postal-code" required>
                  </div>
                </form>

                <div class="step-nav-footer">
                  <div class="step-security-callout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <span>Confidential Australian delivery with strict privacy</span>
                  </div>
                  <button type="button" class="btn btn-primary btn-large" id="step1-next-btn">
                    <span>Continue to Shipping</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <!-- ── STEP 2: Shipping / Delivery ── -->
            <div class="step-pane" id="step-pane-2">
              <div class="card checkout-card">
                <div class="card-header-row">
                  <div>
                    <span class="card-step-tag">Step 2 of 3</span>
                    <h2>Shipping &amp; Delivery Method</h2>
                    <p class="card-step-desc">Select your preferred Australia Post delivery speed. Every package includes full online tracking.</p>
                  </div>
                </div>

                <!-- Step 1 Summary Recall Box -->
                <div class="summary-recall-box">
                  <div class="recall-item">
                    <div class="recall-label">Ship To:</div>
                    <div class="recall-value" id="recall-customer-address">—</div>
                  </div>
                  <div class="recall-item">
                    <div class="recall-label">Contact:</div>
                    <div class="recall-value" id="recall-customer-contact">—</div>
                  </div>
                  <button type="button" class="recall-edit-btn" id="edit-step-1-btn" aria-label="Edit customer information">
                    <span>Edit</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                  </button>
                </div>

                <!-- Delivery Options -->
                <div class="option-list" id="delivery-options">
                  <label class="option-card" for="delivery-standard">
                    <input type="radio" id="delivery-standard" name="delivery" value="standard" data-fee="9.95" checked>
                    <div class="option-content">
                      <div class="option-top-line">
                        <span class="option-title">Standard Tracked Delivery</span>
                        <span class="option-price-tag" id="standard-price-tag">$9.95</span>
                      </div>
                      <span class="option-meta" id="standard-delivery-meta">2–5 business days &middot; Free on orders of $150 or more</span>
                    </div>
                  </label>

                  <label class="option-card" for="delivery-express">
                    <input type="radio" id="delivery-express" name="delivery" value="express" data-fee="19.95">
                    <div class="option-content">
                      <div class="option-top-line">
                        <span class="option-title">Express Post Priority</span>
                        <span class="option-price-tag">$19.95</span>
                      </div>
                      <span class="option-meta">1–2 business days &middot; Priority warehouse packing &amp; fast transit</span>
                    </div>
                  </label>
                </div>

                <!-- Discreet Guarantee Callout -->
                <div class="stealth-packaging-banner">
                  <div class="stealth-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  </div>
                  <div class="stealth-text">
                    <strong>100% Odour-Proof Guarantee:</strong> All orders are vacuum-sealed inside thick multi-layer Mylar barrier bags and shipped in unmarked Australian Post padded satchels with generic return addressing.
                  </div>
                </div>

                <div class="step-nav-footer">
                  <button type="button" class="btn btn-outline" id="step2-prev-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="19" y1="12" x2="5" y2="12"></line>
                      <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to Details</span>
                  </button>
                  <button type="button" class="btn btn-primary btn-large" id="step2-next-btn">
                    <span>Continue to Payment</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <!-- ── STEP 3: Payment Method ── -->
            <div class="step-pane" id="step-pane-3">
              <div class="card checkout-card">
                <div class="card-header-row">
                  <div>
                    <span class="card-step-tag">Step 3 of 3</span>
                    <h2>Choose Payment Method</h2>
                    <p class="card-step-desc">Pick your preferred payment option. Pay with Bitcoin for an immediate 10% discount, or pay via Bank Transfer / PayID.</p>
                  </div>
                </div>

                <!-- Recall Summary (Customer & Shipping) -->
                <div class="summary-recall-box">
                  <div class="recall-item">
                    <div class="recall-label">Recipient:</div>
                    <div class="recall-value" id="recall-step3-customer">—</div>
                  </div>
                  <div class="recall-item">
                    <div class="recall-label">Delivery:</div>
                    <div class="recall-value" id="recall-step3-shipping">—</div>
                  </div>
                  <button type="button" class="recall-edit-btn" id="edit-step-2-btn" aria-label="Change delivery method">
                    <span>Edit</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                  </button>
                </div>

                <!-- Payment Option Cards -->
                <div class="option-list" id="payment-options">
                  <label class="option-card" for="payment-bitcoin">
                    <input type="radio" id="payment-bitcoin" name="payment" value="bitcoin" checked>
                    <div class="option-content">
                      <div class="option-top-line">
                        <span class="option-title">
                          <svg width="20" height="20" viewBox="0 0 64 64" style="vertical-align:-4px;margin-right:6px;"><circle cx="32" cy="32" r="32" fill="#F7931A"/><path d="M46.1 27.4c.6-4.2-2.6-6.5-7-8l1.4-5.7-3.5-.9-1.4 5.5c-.9-.2-1.9-.4-2.8-.7l1.4-5.5-3.5-.9-1.4 5.7c-.8-.2-1.5-.3-2.2-.5l0 0-4.8-1.2-.9 3.7s2.6.6 2.5.6c1.4.4 1.7 1.3 1.6 2l-1.6 6.6c.1 0 .2 0 .3.1l-.3-.1-2.3 9.2c-.2.4-.6 1.1-1.6.8 0 0-2.5-.6-2.5-.6l-1.7 4 4.5 1.1c.8.2 1.7.4 2.5.6l-1.5 5.8 3.5.9 1.4-5.7c1 .3 1.9.5 2.8.7l-1.4 5.7 3.5.9 1.5-5.8c5.8 1.1 10.2.7 12-4.6 1.5-4.3-.1-6.7-3.2-8.3 2.2-.5 3.9-2 4.4-5.1zm-7.8 10.9c-1.1 4.3-8.2 2-10.5 1.4l1.9-7.5c2.3.6 9.7 1.7 8.6 6.1zm1-11c-1 3.9-6.9 1.9-8.8 1.4l1.7-6.8c1.9.5 8.2 1.4 7.1 5.4z" fill="#FFF"/></svg>
                          Bitcoin (BTC)
                          <span class="btc-discount-badge">10% OFF</span>
                        </span>
                        <span class="option-badge-popular">Instant &amp; Private</span>
                      </div>
                      <span class="option-meta">Automatic 10% discount on order total &middot; Private blockchain verification &middot; Zero bank records</span>
                    </div>
                  </label>

                  <label class="option-card" for="payment-bank">
                    <input type="radio" id="payment-bank" name="payment" value="bank">
                    <div class="option-content">
                      <div class="option-top-line">
                        <span class="option-title">
                          <svg width="20" height="20" viewBox="0 0 24 24" style="vertical-align:-4px;margin-right:6px;"><circle cx="12" cy="12" r="12" fill="#1F4D3C"/><path d="M12 4.5L5 8.5V9.5H19V8.5L12 4.5Z" fill="#fff"/><rect x="6.5" y="10.5" width="2" height="5" rx="0.3" fill="#fff"/><rect x="9.5" y="10.5" width="2" height="5" rx="0.3" fill="#fff"/><rect x="12.5" y="10.5" width="2" height="5" rx="0.3" fill="#fff"/><rect x="15.5" y="10.5" width="2" height="5" rx="0.3" fill="#fff"/><rect x="5" y="16" width="14" height="1.5" rx="0.3" fill="#fff"/></svg>
                          Bank Transfer / PayID
                        </span>
                        <span class="option-badge-fee">Zero Fees</span>
                      </div>
                      <span class="option-meta">PayID (Instant 24/7) or standard BSB transfer &middot; Account details provided securely via Live Chat</span>
                    </div>
                  </label>
                </div>

                <!-- Bitcoin Instruction Panel -->
                <div class="payment-panel" id="bitcoin-panel">
                  <div class="panel-header">
                    <h3>Pay with Bitcoin &amp; Save 10%</h3>
                    <p>After clicking "Place Order", your unique order reference and QR wallet code will appear with the discounted total.</p>
                  </div>
                  <div class="btc-info-box">
                    <div class="btc-info-item">
                      <span class="btc-info-dot"></span>
                      <span><strong>10% Discount:</strong> Deducted automatically from your order total.</span>
                    </div>
                    <div class="btc-info-item">
                      <span class="btc-info-dot"></span>
                      <span><strong>Discreet:</strong> Your transaction exists only on the blockchain &mdash; no credit card statement traces.</span>
                    </div>
                    <div class="btc-info-item">
                      <span class="btc-info-dot"></span>
                      <span><strong>New to crypto?</strong> CoinSpot, CoinJar and Swyftx support instant Australian PayID deposits. <a href="/buy-bitcoin/" target="_blank">View our Beginner Guide &rarr;</a></span>
                    </div>
                  </div>
                </div>

                <!-- Bank Transfer / PayID Panel -->
                <div class="payment-panel" id="bank-panel" style="display: none;">
                  <div class="panel-header">
                    <h3>Pay via Bank Transfer or PayID</h3>
                    <p>For your financial safety and anti-interception protection, our bank account and PayID details are provided via 1-on-1 Live Chat.</p>
                  </div>
                  <div class="bank-info-notice">
                    <div class="notice-icon">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div class="notice-content">
                      <strong>How it works:</strong>
                      <ol class="bank-steps-list">
                        <li>Click <strong>"Place Order"</strong> below to confirm your items.</li>
                        <li>On the confirmation page, click <strong>"Open Live Chat"</strong> (bottom-right chat bubble).</li>
                        <li>Our team instantly replies with our current PayID and account details.</li>
                        <li>Send the exact amount from your Australian banking app. Your order is dispatched the same day!</li>
                      </ol>
                    </div>
                  </div>
                  <div class="info-alert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    <span><strong>Instant 24/7 Payments:</strong> PayID transfers clear instantly between all major Australian banks, including CommBank, NAB, ANZ, Westpac, and ING.</span>
                  </div>
                </div>

                <div class="step-nav-footer">
                  <button type="button" class="btn btn-outline" id="step3-prev-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="19" y1="12" x2="5" y2="12"></line>
                      <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to Shipping</span>
                  </button>
                  <button type="button" class="btn btn-primary btn-large btn-final" id="place-order-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span id="place-order-label">Place Order &mdash; $0.00</span>
                  </button>
                </div>
              </div>
            </div>

          </div>

          <!-- ── Right Column: Order Summary ── -->
          <aside class="checkout-summary" id="checkout-summary">
            <div class="summary-card">
              <div class="summary-card-header">
                <h3>Order Summary</h3>
                <span class="summary-item-badge" id="summary-count-badge">0 items</span>
              </div>

              <!-- Cart items preview -->
              <div id="summary-items" class="summary-items"></div>

              <!-- Promo Code in Checkout -->
              <div class="checkout-promo-box">
                <div class="promo-input-row">
                  <input type="text" id="checkout-promo-code" placeholder="PROMO CODE (e.g. WELCOME15)" autocomplete="off">
                  <button type="button" class="btn btn-outline btn-sm" id="checkout-promo-btn">Apply</button>
                </div>
                <div id="checkout-promo-msg" style="display: none;"></div>
              </div>

              <!-- Pricing breakdown -->
              <div class="summary-pricing">
                <div class="summary-row">
                  <span>Subtotal</span>
                  <span id="summary-subtotal">$0.00</span>
                </div>
                <div class="summary-row">
                  <span>Shipping</span>
                  <span id="summary-shipping">$0.00</span>
                </div>
                <div class="summary-row summary-discount" id="summary-promo-row" style="display: none;">
                  <span style="color:#059669;font-weight:600;" id="summary-promo-label">Promo Discount</span>
                  <span id="summary-promo" style="color:#059669;font-weight:600;">-$0.00</span>
                </div>
                <div class="summary-row summary-discount" id="summary-discount-row" style="display: none;">
                  <span style="color:#059669;font-weight:600;">Bitcoin Discount (10%)</span>
                  <span id="summary-discount" style="color:#059669;font-weight:600;">-$0.00</span>
                </div>
                
                <div class="summary-divider"></div>
                
                <div class="summary-row summary-total">
                  <span>Grand Total (AUD)</span>
                  <span id="summary-total">$0.00</span>
                </div>
              </div>

              <!-- Trust Assurances -->
              <div class="summary-trust-perks">
                <div class="trust-perk">
                  <span class="trust-perk-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  </span>
                  <span><strong>100% Delivery Guarantee:</strong> Arrives safely or immediate free reshipment</span>
                </div>
                <div class="trust-perk loyalty-perk">
                  <span class="trust-perk-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  </span>
                  <span>Earn <strong id="checkout-loyalty-pts">0</strong> Mullaways Loyalty Points on this order</span>
                </div>
                <div class="trust-perk">
