  let currentStep = 1;
  const stepPanes = {
    1: document.getElementById('step-pane-1'),
    2: document.getElementById('step-pane-2'),
    3: document.getElementById('step-pane-3'),
  };
  const stepNavs = {
    1: document.getElementById('step-nav-1'),
    2: document.getElementById('step-nav-2'),
    3: document.getElementById('step-nav-3'),
  };
  const connectors = {
    1: document.getElementById('connector-1'),
    2: document.getElementById('connector-2'),
  };

  const step1NextBtn = document.getElementById('step1-next-btn');
  const step2PrevBtn = document.getElementById('step2-prev-btn');
  const step2NextBtn = document.getElementById('step2-next-btn');
  const step3PrevBtn = document.getElementById('step3-prev-btn');
  const placeOrderBtn = document.getElementById('place-order-btn');
  const placeOrderLabel = document.getElementById('place-order-label');

  const editStep1Btn = document.getElementById('edit-step-1-btn');
  const editStep2Btn = document.getElementById('edit-step-2-btn');

  // Recall boxes
  const recallCustomerAddress = document.getElementById('recall-customer-address');
  const recallCustomerContact = document.getElementById('recall-customer-contact');
  const recallStep3Customer = document.getElementById('recall-step3-customer');
  const recallStep3Shipping = document.getElementById('recall-step3-shipping');

  // Panels
  const bitcoinPanel = document.getElementById('bitcoin-panel');
  const bankPanel = document.getElementById('bank-panel');

  const BTC_DISCOUNT_RATE = 0.10;
  const BTC_ADDRESS = 'bc1qev9qvwxennyypmth024jndwlqqh7ft9mzjnapr';

  const VALID_PROMOS = {
    'WELCOME15': { rate: 0.15, label: '15% Off First Order' },
    'FIRST15': { rate: 0.15, label: '15% Off First Order' },
    'MULLAWAYS15': { rate: 0.15, label: '15% Off First Order' },
    'SAVE10': { rate: 0.10, label: '10% Off' },
  };

  function escHtml(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function getFormValue(id) {
    const el = document.getElementById(id);
    if (!el) return '';
    if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) {
      return el.value.trim();
    }
    return '';
  }

  function getAppliedPromo() {
    try {
      const stored = localStorage.getItem('appliedPromo');
      return stored ? JSON.parse(stored) : null;
    } catch {
      return null;
    }
  }

  function getSelectedPayment() {
    const el = document.querySelector('input[name="payment"]:checked');
    return el instanceof HTMLInputElement ? el.value : 'bitcoin';
  }

  function getSelectedDelivery() {
    const el = document.querySelector('input[name="delivery"]:checked');
    return el instanceof HTMLInputElement ? el.value : 'standard';
  }

  function getShippingFee(subtotal) {
    const method = getSelectedDelivery();
    if (method === 'standard') {
      return subtotal >= 150 ? 0 : 9.95;
    }
    return 19.95; // Express
  }

  function getPromoDiscount(subtotal) {
    const promo = getAppliedPromo();
    if (!promo || !promo.rate) return 0;
    return Math.round(subtotal * promo.rate * 100) / 100;
  }

  function getBtcDiscount(baseAmount) {
    return getSelectedPayment() === 'bitcoin' ? Math.round(baseAmount * BTC_DISCOUNT_RATE * 100) / 100 : 0;
  }

  function generateOrderRef() {
    const timestamp = Date.now().toString(36).toUpperCase();
    const random = Math.random().toString(36).substring(2, 6).toUpperCase();
    return `MW-${timestamp.slice(-4)}${random}`;
  }

  // ── Render Summary ────────────────────────────────────────────
  function renderSummary() {
    if (!summaryItems || !summarySubtotal || !summaryShipping || !summaryTotal) return;

    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const shipping = getShippingFee(subtotal);
    const promoDiscount = getPromoDiscount(subtotal);
    const promo = getAppliedPromo();
    const btcDiscount = getBtcDiscount(Math.max(0, subtotal - promoDiscount));
    const total = Math.max(0, subtotal - promoDiscount + shipping - btcDiscount);

    if (summaryCountBadge) {
      const totalQty = cart.reduce((sum, i) => sum + i.quantity, 0);
      summaryCountBadge.textContent = `${totalQty} item${totalQty !== 1 ? 's' : ''}`;
    }

    if (standardDeliveryMeta && standardPriceTag) {
      if (subtotal >= 150) {
        standardPriceTag.innerHTML = '<span style="color:#059669;">FREE</span>';
        standardDeliveryMeta.innerHTML = '2–5 business days &middot; <strong style="color:#059669;">Free Shipping applied</strong>';
      } else {
        const remaining = (150 - subtotal).toFixed(2);
        standardPriceTag.textContent = '$9.95';
        standardDeliveryMeta.textContent = `2–5 business days · Add $${remaining} for FREE delivery`;
      }
    }

    summaryItems.innerHTML = cart.map((item) => `
      <div class="summary-item">
        <span>${escHtml(item.name)} &times; ${item.quantity}</span>
        <strong>$${(item.price * item.quantity).toFixed(2)}</strong>
      </div>
    `).join('');

    summarySubtotal.textContent = `$${subtotal.toFixed(2)}`;

    if (shipping === 0) {
      summaryShipping.innerHTML = '<strong style="color:#059669;">FREE</strong>';
    } else {
      summaryShipping.textContent = `$${shipping.toFixed(2)}`;
    }

    if (summaryPromoRow && summaryPromo) {
      if (promoDiscount > 0 && promo) {
        summaryPromoRow.style.display = 'flex';
        if (summaryPromoLabel) summaryPromoLabel.textContent = `Promo (${promo.code}) -${Math.round(promo.rate * 100)}%`;
        summaryPromo.textContent = `-$${promoDiscount.toFixed(2)}`;
      } else {
        summaryPromoRow.style.display = 'none';
      }
    }

    if (summaryDiscountRow && summaryDiscount) {
      if (btcDiscount > 0) {
        summaryDiscountRow.style.display = 'flex';
        summaryDiscount.textContent = `-$${btcDiscount.toFixed(2)}`;
      } else {
        summaryDiscountRow.style.display = 'none';
      }
    }

    summaryTotal.textContent = `$${total.toFixed(2)}`;
    const checkoutLoyaltyEl = document.getElementById('checkout-loyalty-pts');
    if (checkoutLoyaltyEl) {
      checkoutLoyaltyEl.textContent = Math.round(total).toString();
    }
    if (placeOrderLabel) {
      placeOrderLabel.textContent = `Place Order &mdash; $${total.toFixed(2)}`;
    }

    renderCheckoutPromoUI(promo);
    updateRecallSummaries();
  }

  function updateRecallSummaries() {
    const name = `${getFormValue('firstName')} ${getFormValue('lastName')}`.trim();
    const address = `${getFormValue('address')}, ${getFormValue('city')}, ${getFormValue('state')} ${getFormValue('postcode')}`.trim();
    const contact = `${getFormValue('email')} &middot; ${getFormValue('phone')}`.trim();
    const method = getSelectedDelivery() === 'express' ? 'Express Post ($19.95)' : 'Standard Delivery (2–5 days)';

    if (recallCustomerAddress) recallCustomerAddress.textContent = address || '—';
    if (recallCustomerContact) recallCustomerContact.innerHTML = contact || '—';
    if (recallStep3Customer) recallStep3Customer.textContent = `${name ? name + ' — ' : ''}${address}`;
    if (recallStep3Shipping) recallStep3Shipping.textContent = method;
  }

  // ── Step Navigation ───────────────────────────────────────────
  let completedStep1 = false;
  let completedStep2 = false;

  function goToStep(targetStep) {
    if (targetStep === currentStep) return;

    // Validate before moving forward
    if (targetStep > currentStep) {
      if (currentStep === 1 && !validateStep1()) return;
      if (currentStep === 2 && !validateStep2()) return;
    }

    if (currentStep === 1) completedStep1 = true;
    if (currentStep === 2) completedStep2 = true;

    // Switch panes
    Object.keys(stepPanes).forEach((step) => {
      const num = Number(step);
      if (num === targetStep) {
        stepPanes[num]?.classList.add('active');
      } else {
        stepPanes[num]?.classList.remove('active');
      }
    });

    // Update stepper classes
    for (let i = 1; i <= 3; i++) {
      const btn = stepNavs[i];
      if (!btn) continue;
      btn.classList.remove('active');

      if (i < targetStep) {
        btn.classList.add('completed');
        btn.classList.add('clickable');
      } else if (i === targetStep) {
        btn.classList.add('active');
        btn.classList.remove('completed');
      } else {
        btn.classList.remove('completed');
        if ((i === 2 && completedStep1) || (i === 3 && completedStep2)) {
          btn.classList.add('clickable');
        } else {
          btn.classList.remove('clickable');
        }
      }
    }

    // Update connectors
    if (connectors[1]) connectors[1].classList.toggle('completed', targetStep >= 2);
    if (connectors[2]) connectors[2].classList.toggle('completed', targetStep >= 3);

    currentStep = targetStep;
    updateRecallSummaries();

    // Scroll to top of checkout smoothly
    checkoutLayout?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function validateStep1() {
    const requiredFields = ['firstName', 'lastName', 'email', 'phone', 'address', 'city', 'state', 'postcode'];
    let firstError = null;
    let isValid = true;

    document.querySelectorAll('#checkout-details .form-error').forEach(el => el.remove());
    document.querySelectorAll('#checkout-details .input-error').forEach(el => el.classList.remove('input-error'));

    for (const fieldId of requiredFields) {
      const el = document.getElementById(fieldId);
      if (!el) continue;

      const value = (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) ? el.value.trim() : '';
      let error = '';

      if (!value) {
        error = 'This field is required';
      } else if (fieldId === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        error = 'Please enter a valid email address';
      } else if (fieldId === 'phone' && !/^[\d\s\+\-\(\)]{8,15}$/.test(value)) {
        error = 'Please enter a valid phone number';
      } else if (fieldId === 'postcode' && !/^\d{4}$/.test(value)) {
        error = 'Please enter a valid 4-digit Australian postcode';
      }

      if (error) {
        isValid = false;
        el.classList.add('input-error');
        const errorEl = document.createElement('span');
        errorEl.className = 'form-error';
        errorEl.textContent = error;
        el.parentElement?.appendChild(errorEl);
        if (!firstError) firstError = el;
      }
    }

    if (firstError) {
      firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
      firstError.focus();
    }

    return isValid;
  }

  function validateStep2() {
    return true; // Delivery option has standard selected by default
  }

  // Stepper Header Click Events
  Object.keys(stepNavs).forEach((step) => {
    const num = Number(step);
    stepNavs[num]?.addEventListener('click', () => {
      if (num < currentStep || (num === 2 && completedStep1) || (num === 3 && completedStep2)) {
        goToStep(num);
      }
    });
  });

  step1NextBtn?.addEventListener('click', () => {
    if (validateStep1()) {
      completedStep1 = true;
      goToStep(2);
    }
  });

  step2PrevBtn?.addEventListener('click', () => goToStep(1));
  step2NextBtn?.addEventListener('click', () => {
    completedStep2 = true;
    goToStep(3);
  });

  step3PrevBtn?.addEventListener('click', () => goToStep(2));
  editStep1Btn?.addEventListener('click', () => goToStep(1));
  editStep2Btn?.addEventListener('click', () => goToStep(2));

  // ── Payment Panels ────────────────────────────────────────────
  function togglePaymentPanels() {
    const method = getSelectedPayment();
    if (bitcoinPanel) bitcoinPanel.style.display = method === 'bitcoin' ? 'block' : 'none';
    if (bankPanel) bankPanel.style.display = method === 'bank' ? 'block' : 'none';
    renderSummary();
  }

  document.querySelectorAll('input[name="payment"]').forEach((input) => {
    input.addEventListener('change', togglePaymentPanels);
  });

  document.querySelectorAll('input[name="delivery"]').forEach((input) => {
    input.addEventListener('change', renderSummary);
  });

  // ── Promo Code Handling ───────────────────────────────────────
  function renderCheckoutPromoUI(promo) {
    if (!checkoutPromoMsg) return;
    if (promo) {
      if (checkoutPromoCode) {
        checkoutPromoCode.value = promo.code;
        checkoutPromoCode.disabled = true;
      }
      if (checkoutPromoBtn) {
        checkoutPromoBtn.textContent = 'Remove';
        checkoutPromoBtn.classList.remove('btn-outline');
        checkoutPromoBtn.classList.add('btn-ghost');
      }
      checkoutPromoMsg.style.display = 'block';
      checkoutPromoMsg.style.color = '#059669';
      checkoutPromoMsg.innerHTML = `✓ Code <strong>${promo.code}</strong> applied (${Math.round(promo.rate * 100)}% off)`;
    } else {
      if (checkoutPromoCode) checkoutPromoCode.disabled = false;
      if (checkoutPromoBtn) {
        checkoutPromoBtn.textContent = 'Apply';
        checkoutPromoBtn.classList.remove('btn-ghost');
        checkoutPromoBtn.classList.add('btn-outline');
      }
    }
  }

  function handleCheckoutPromo() {
    const promo = getAppliedPromo();
    if (promo) {
      localStorage.removeItem('appliedPromo');
      if (checkoutPromoCode) checkoutPromoCode.value = '';
      if (checkoutPromoMsg) {
        checkoutPromoMsg.style.display = 'none';
        checkoutPromoMsg.textContent = '';
      }
      renderSummary();
      return;
    }

    if (!checkoutPromoCode || !checkoutPromoMsg) return;
    const code = checkoutPromoCode.value.trim().toUpperCase();
    if (!code) {
      checkoutPromoMsg.style.display = 'block';
      checkoutPromoMsg.style.color = '#DC2626';
      checkoutPromoMsg.textContent = 'Please enter a promo code.';
      return;
    }

    if (VALID_PROMOS[code]) {
      const info = VALID_PROMOS[code];
      localStorage.setItem('appliedPromo', JSON.stringify({ code, rate: info.rate, label: info.label }));
      renderSummary();
    } else {
      checkoutPromoMsg.style.display = 'block';
      checkoutPromoMsg.style.color = '#DC2626';
      checkoutPromoMsg.innerHTML = 'Invalid code. Use <strong>WELCOME15</strong> for 15% off.';
    }
  }

  checkoutPromoBtn?.addEventListener('click', handleCheckoutPromo);
  checkoutPromoCode?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleCheckoutPromo();
    }
  });

  // ── Place Order Final Submission ──────────────────────────────
  function buildTemplateParams(order) {
    const itemsList = order.items.map(i =>
      `${i.name} × ${i.quantity} — $${(i.price * i.quantity).toFixed(2)}`
    ).join('\n');

    let paymentStatus = '';
    let paymentNextStep = '';

    if (order.payment === 'bitcoin') {
      paymentStatus = 'Awaiting Bitcoin payment';
      paymentNextStep = 'Please send the exact amount shown on the order confirmation page to the Bitcoin address provided. Your order will be dispatched once verified on the blockchain.';
    } else if (order.payment === 'bank') {
      paymentStatus = 'Awaiting bank transfer';
      paymentNextStep = 'Please open Live Chat on our website to receive our PayID or bank transfer details. For your security we share banking details exclusively via Live Chat.';
    }

    const discountParts = [];
    if (order.promoDiscount && order.promoDiscount > 0) {
      discountParts.push(`-$${order.promoDiscount.toFixed(2)} (Promo: ${order.promoCode || 'Applied'})`);
    }
    if (order.discount && order.discount > 0) {
      discountParts.push(`-$${order.discount.toFixed(2)} (Bitcoin 10% discount)`);
    }
    const discountText = discountParts.length > 0 ? discountParts.join(' + ') : '$0.00';
    const shippingText = order.shipping === 0 ? 'FREE (Standard delivery over $150)' : `$${order.shipping.toFixed(2)}`;

    return {
      to_email: order.customer.email,
      to_name: `${order.customer.firstName} ${order.customer.lastName}`,
      order_ref: order.ref,
      order_date: new Date(order.date).toLocaleDateString('en-AU', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
      }),
      items_list: itemsList,
      subtotal: `$${order.subtotal.toFixed(2)}`,
      discount: discountText,
      shipping: shippingText,
      total: `$${order.total.toFixed(2)}`,
      payment_method: order.payment === 'bitcoin' ? 'Bitcoin' : 'Bank Transfer',
      payment_status: paymentStatus,
      payment_next_step: paymentNextStep,
      shipping_address: `${order.customer.address}, ${order.customer.city}, ${order.customer.state} ${order.customer.postcode}`,
      delivery_method: order.shippingMethod === 'express'
        ? 'Express (1–2 business days)'
        : (order.shipping === 0 ? 'Standard (2–5 business days, Free shipping)' : 'Standard (2–5 business days)'),
      customer_email: order.customer.email,
      customer_phone: order.customer.phone,
      btc_address: order.btcAddress || '',
    };
  }

  async function sendCustomerEmail(order) {
    try {
      const data = buildTemplateParams(order);
      const res = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({ type: 'order-customer', data }),
      });
      return { success: res.ok };
    } catch {
      return { success: false };
    }
  }

  async function sendAdminEmail(order) {
    try {
      const data = buildTemplateParams(order);
      const res = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({ type: 'order-admin', data }),
      });
      return { success: res.ok };
    } catch {
      return { success: false };
    }
  }

  async function placeOrder() {
    if (!validateStep1()) {
      goToStep(1);
      return;
    }

    const selectedPayment = getSelectedPayment();
    const shippingMethod = getSelectedDelivery();

    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const shippingFee = getShippingFee(subtotal);
    const promo = getAppliedPromo();
    const promoDiscount = getPromoDiscount(subtotal);
    const discount = getBtcDiscount(Math.max(0, subtotal - promoDiscount));
    const total = Math.max(0, subtotal - promoDiscount + shippingFee - discount);

    const order = {
      ref: generateOrderRef(),
      date: new Date().toISOString(),
      items: cart.map(item => ({ name: item.name, price: item.price, quantity: item.quantity })),
      subtotal,
      shipping: shippingFee,
      shippingMethod,
      promoCode: promo ? promo.code : '',
      promoDiscount,
      discount,
      total,
      payment: selectedPayment,
      btcAddress: selectedPayment === 'bitcoin' ? BTC_ADDRESS : '',
      status: 'pending',
      emailsSent: false,
      customer: {
        firstName: getFormValue('firstName'),
        lastName: getFormValue('lastName'),
        email: getFormValue('email'),
        phone: getFormValue('phone'),
        address: getFormValue('address'),
        city: getFormValue('city'),
        state: getFormValue('state'),
        postcode: getFormValue('postcode'),
      }
    };

    if (placeOrderBtn) {
      placeOrderBtn.disabled = true;
      placeOrderBtn.innerHTML = `
        <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" stroke-dasharray="31.4 31.4" stroke-linecap="round">
            <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite"/>
          </circle>
        </svg>
        Securing Order...
      `;
    }

    try {
      localStorage.setItem('lastOrder', JSON.stringify(order));
      const orderHistory = JSON.parse(localStorage.getItem('orderHistory') || '[]');
      orderHistory.unshift(order);
      localStorage.setItem('orderHistory', JSON.stringify(orderHistory));

      // Outbound emails
      if (order.payment !== 'bitcoin') {
        // Bank Transfer: send customer confirmation and admin notification immediately
        try {
          const [cRes, aRes] = await Promise.allSettled([
            sendCustomerEmail(order),
            sendAdminEmail(order)
          ]);
          const custOk = cRes.status === 'fulfilled' && cRes.value && cRes.value.success;
          const adminOk = aRes.status === 'fulfilled' && aRes.value && aRes.value.success;
          order.emailsSent = Boolean(custOk && adminOk);
          localStorage.setItem('lastOrder', JSON.stringify(order));
        } catch (emailErr) {
          console.warn('Email dispatch warning:', emailErr);
        }
      } else {
        // Crypto orders: user must pay to the crypto address before confirmation email is sent
        order.emailsSent = false;
        localStorage.setItem('lastOrder', JSON.stringify(order));
      }

      // Clear cart
      localStorage.removeItem('cart');
      localStorage.removeItem('appliedPromo');
      window.dispatchEvent(new CustomEvent('cartUpdated'));

      await new Promise(resolve => setTimeout(resolve, 300));
      window.location.href = `/order-confirmation/?ref=${order.ref}`;

    } catch (err) {
      console.error('Order placement error:', err);
      if (placeOrderBtn) {
        placeOrderBtn.disabled = false;
        placeOrderBtn.textContent = 'Place Order';
      }
    }
  }

  placeOrderBtn?.addEventListener('click', placeOrder);

  // Clear errors on input
  document.querySelectorAll('#checkout-details input, #checkout-details select').forEach((input) => {
    input.addEventListener('input', () => {
      input.classList.remove('input-error');
      const error = input.parentElement?.querySelector('.form-error');
      if (error) error.remove();
      updateRecallSummaries();
    });
  });

  // Init
  if (cart.length === 0) {
    if (checkoutLayout) checkoutLayout.style.display = 'none';
    if (checkoutEmpty) checkoutEmpty.style.display = 'block';
  } else {
    renderSummary();
  }
</script>
